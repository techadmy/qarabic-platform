// Qarabic LMS — PostgreSQL schema (docs/34 §3.3).
// Every time is timestamptz (UTC stored; the person's zone is kept in users.timezone).
// Tables and columns are snake_case; the TypeScript client uses camelCase.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  ar
  en
}

enum RoleKind {
  owner
  staff
  teacher
  parent
}

/// Family account status (docs/06 §4, docs/28 §4.1).
enum FamilyStatus {
  regular
  trial
  on_leave
  suspended
  deactivated
}

/// Students, teachers and staff.
enum ActiveStatus {
  active
  inactive
}

enum Gender {
  male
  female
}

/// Who a teacher takes for trials (docs/33 §4.1).
enum TeacherAudience {
  children
  adults
  both
}

enum StudentLanguage {
  english
  urdu
  english_urdu
  pashto
  arabic
}

enum CourseCategory {
  regular
  additional
}

/// The record a status_changes row belongs to.
enum PersonType {
  family
  student
  teacher
  staff
  enrollment
}

model User {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(255)
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  /// E.164 (`+447700900123`). A parent's phone is the family's contact number; a teacher's is theirs.
  phone             String?   @db.VarChar(16)
  locale            Locale    @default(ar)
  timezone          String    @default("Africa/Cairo") @db.VarChar(64)
  isActive          Boolean   @default(true) @map("is_active")
  roleId            Int?      @map("role_id")
  /// Staff status change (D130): why and by whom the login was (de)activated.
  statusReason      String?   @map("status_reason") @db.VarChar(500)
  statusChangedAt   DateTime? @map("status_changed_at") @db.Timestamptz(6)
  statusChangedById Int?      @map("status_changed_by")
  /// Archive ("delete", D128) of a staff member.
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedById      Int?      @map("archived_by")
  archiveReason     String?   @map("archive_reason") @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // N4 support centre
  ticketsReported Ticket[]        @relation("TicketReporter")
  ticketsAssigned Ticket[]        @relation("TicketAssignee")
  ticketComments  TicketComment[]

  role                Role?                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  statusChangedBy     User?                @relation("UserStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: SetNull)
  archivedBy          User?                @relation("UserArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  family              Family?              @relation("FamilyParent")
  teacher             Teacher?             @relation("TeacherUser")

  // N5 CRM
  leadsAssigned          Lead[]                 @relation("LeadAssignee")
  leadsCreated           Lead[]                 @relation("LeadCreatedBy")
  leadsConverted         Lead[]                 @relation("LeadConvertedBy")
  leadActivities         LeadActivity[]
  notifications          Notification[]
  // N6 billing
  feePackagesCreated     FeePackage[]           @relation("FeePackageCreatedBy")
  billingProfilesUpdated FamilyBillingProfile[] @relation("BillingProfileUpdatedBy")
  studentPackagesUpdated StudentFeePackage[]    @relation("StudentFeePackageUpdatedBy")
  invoicesIssued         Invoice[]              @relation("InvoiceIssuedBy")
  invoicesVoided         Invoice[]              @relation("InvoiceVoidedBy")
  invoicesCreated        Invoice[]              @relation("InvoiceCreatedBy")
  invoiceLinesCreated    InvoiceLine[]          @relation("InvoiceLineCreatedBy")
  paymentsRecorded       Payment[]              @relation("PaymentRecordedBy")
  paymentsInitiated      Payment[]              @relation("PaymentInitiatedBy")

  usersStatusChanged    User[]           @relation("UserStatusChangedBy")
  usersArchived         User[]           @relation("UserArchivedBy")
  managedFamilies       Family[]         @relation("FamilyManager")
  familiesStatusChanged Family[]         @relation("FamilyStatusChangedBy")
  familiesArchived      Family[]         @relation("FamilyArchivedBy")
  studentsStatusChanged Student[]        @relation("StudentStatusChangedBy")
  studentsArchived      Student[]        @relation("StudentArchivedBy")
  teachersStatusChanged Teacher[]        @relation("TeacherStatusChangedBy")
  teachersArchived      Teacher[]        @relation("TeacherArchivedBy")
  statusChanges         StatusChange[]
  auditLogs             AuditLog[]
  settingsUpdated       AppSetting[]
  enrollmentsCreated    Enrollment[]     @relation("EnrollmentCreatedBy")
  sessionEvents         SessionEvent[]
  sessionsMarked        ClassSession[]   @relation("SessionMarkedBy")
  sessionRequests       SessionRequest[] @relation("SessionRequestRequester")
  sessionDecisions      SessionRequest[] @relation("SessionRequestDecider")
  reportsSubmitted      LessonReport[]   @relation("LessonReportSubmittedBy")
  reportsUpdated        LessonReport[]   @relation("LessonReportUpdatedBy")
  testsCreated          StudentTest[]    @relation("StudentTestCreatedBy")
  testsRecorded         StudentTest[]    @relation("StudentTestRecordedBy")
  testsDecided          StudentTest[]    @relation("StudentTestDecidedBy")

  // N7 payroll back-relations.
  payProfile            PayProfile?         @relation("PayProfileUser")
  payProfilesUpdated    PayProfile[]        @relation("PayProfileUpdatedBy")
  attendance            StaffAttendance[]   @relation("AttendanceUser")
  attendanceRecorded    StaffAttendance[]   @relation("AttendanceRecordedBy")
  leaveRequests         LeaveRequest[]      @relation("LeaveRequestUser")
  leaveRequested        LeaveRequest[]      @relation("LeaveRequestRequestedBy")
  leaveDecided          LeaveRequest[]      @relation("LeaveRequestDecidedBy")
  payAdjustments        PayAdjustment[]     @relation("PayAdjustmentUser")
  payAdjustmentsMade    PayAdjustment[]     @relation("PayAdjustmentCreatedBy")
  payAdjustmentsDecided PayAdjustment[]     @relation("PayAdjustmentDecidedBy")
  payrollRunsCreated    PayrollRun[]        @relation("PayrollRunCreatedBy")
  payrollRunsReviewed   PayrollRun[]        @relation("PayrollRunReviewedBy")
  payrollRunsApproved   PayrollRun[]        @relation("PayrollRunApprovedBy")
  payslips              Payslip[]           @relation("PayslipUser")
  payslipsPaid          Payslip[]           @relation("PayslipPaidBy")
  walletTransactions    WalletTransaction[] @relation("WalletUser")
  walletTxCreated       WalletTransaction[] @relation("WalletCreatedBy")
  payRuleSetsCreated    PayRuleSet[]

  // M7 accounting back-relations.
  journalEntriesCreated JournalEntry[]     @relation("JournalEntryCreatedBy")
  vouchersCreated       Voucher[]          @relation("VoucherCreatedBy")
  vouchersVoided        Voucher[]          @relation("VoucherVoidedBy")
  periodsClosed         AccountingPeriod[] @relation("PeriodClosedBy")

  // M8 operations back-relations.
  tasksAssigned           Task[]                   @relation("TaskAssignee")
  tasksCreated            Task[]                   @relation("TaskCreatedBy")
  taskEvents              TaskEvent[]
  taskTemplatesCreated    TaskTemplate[]
  announcementsCreated    Announcement[]
  announcementReads       AnnouncementRead[]
  notificationPreferences NotificationPreference[]
  classReminders          ClassReminder[]
  devices                 DeviceToken[]

  trialOffersCreated TrialOffer[] @relation("TrialOfferCreatedBy")
  trialOffersClosed  TrialOffer[] @relation("TrialOfferClosedBy")

  @@index([roleId])
  @@index([archivedAt])
  @@map("users")
}

model Role {
  id           Int       @id @default(autoincrement())
  /// Stable slug: system names, or `custom_<id>` for roles made in the app (docs/29).
  name         String    @unique @db.VarChar(100)
  labelAr      String    @unique @map("label_ar") @db.VarChar(255)
  labelEn      String?   @unique @map("label_en") @db.VarChar(255)
  description  String?   @db.VarChar(500)
  kind         RoleKind  @default(staff)
  isSystem     Boolean   @default(false) @map("is_system")
  customizedAt DateTime? @map("customized_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Server-side session. `id` is the sha256 (hex) of the random token in the cookie; the raw token is never stored.
model Session {
  id         String   @id @db.Char(64)
  userId     Int      @map("user_id")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use password reset token. `tokenHash` is the sha256 (hex) of the token sent by mail.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Courses (minimal for N1: the People forms pick them). Lessons, materials and pricing come later.
model Course {
  id        Int            @id @default(autoincrement())
  nameAr    String         @map("name_ar") @db.VarChar(120)
  nameEn    String         @unique @map("name_en") @db.VarChar(120)
  category  CourseCategory @default(regular)
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  regularStudents    Student[]       @relation("StudentRegularCourse")
  additionalStudents Student[]       @relation("StudentAdditionalCourse")
  teachers           TeacherCourse[]
  enrollments        Enrollment[]
  sessions           ClassSession[]
  tests              StudentTest[]

  trialOffers TrialOffer[]

  @@map("courses")
}

/// A family = one parent login (`user_id`) and its children (docs/28 §2).
model Family {
  id                Int          @id @default(autoincrement())
  userId            Int          @unique @map("user_id")
  /// ISO 3166-1 alpha-2.
  countryCode       String?      @map("country_code") @db.Char(2)
  /// IANA zone of the family (classes are shown in it).
  timezone          String       @db.VarChar(64)
  managerId         Int?         @map("manager_id")
  startDate         DateTime?    @map("start_date") @db.Date
  trialDate         DateTime?    @map("trial_date") @db.Date
  zoomId            String?      @map("zoom_id") @db.VarChar(100)
  whatsappGroupId   String?      @map("whatsapp_group_id") @db.VarChar(100)
  comment           String?
  status            FamilyStatus @default(regular)
  statusReason      String?      @map("status_reason") @db.VarChar(500)
  statusChangedAt   DateTime?    @map("status_changed_at") @db.Timestamptz(6)
  statusChangedById Int?         @map("status_changed_by")
  archivedAt        DateTime?    @map("archived_at") @db.Timestamptz(6)
  archivedById      Int?         @map("archived_by")
  archiveReason     String?      @map("archive_reason") @db.VarChar(500)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // N4 support centre
  tickets Ticket[]

  user            User      @relation("FamilyParent", fields: [userId], references: [id], onDelete: Restrict)
  manager         User?     @relation("FamilyManager", fields: [managerId], references: [id], onDelete: SetNull)
  statusChangedBy User?     @relation("FamilyStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: SetNull)
  archivedBy      User?     @relation("FamilyArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  students        Student[]

  // N5 CRM
  leads          Lead[]                @relation("LeadFamily")
  referredLeads  Lead[]                @relation("LeadReferralFamily")
  // N6 billing
  billingProfile FamilyBillingProfile?
  invoices       Invoice[]
  payments       Payment[]

  @@index([status])
  @@index([managerId])
  @@index([archivedAt])
  @@map("families")
}

/// A child of a family. No login of its own (the legacy store made a fake one).
model Student {
  id                 Int              @id @default(autoincrement())
  familyId           Int              @map("family_id")
  name               String           @db.VarChar(120)
  email              String?          @db.VarChar(191)
  gender             Gender?
  age                Int?             @db.SmallInt
  language           StudentLanguage?
  regularCourseId    Int?             @map("regular_course_id")
  additionalCourseId Int?             @map("additional_course_id")
  teacherId          Int?             @map("teacher_id")
  startDate          DateTime?        @map("start_date") @db.Date
  zoomId             String?          @map("zoom_id") @db.VarChar(100)
  remarkParent       String?          @map("remark_parent")
  remarkTeacher      String?          @map("remark_teacher")
  status             ActiveStatus     @default(active)
  statusReason       String?          @map("status_reason") @db.VarChar(500)
  statusChangedAt    DateTime?        @map("status_changed_at") @db.Timestamptz(6)
  statusChangedById  Int?             @map("status_changed_by")
  archivedAt         DateTime?        @map("archived_at") @db.Timestamptz(6)
  archivedById       Int?             @map("archived_by")
  archiveReason      String?          @map("archive_reason") @db.VarChar(500)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  family           Family           @relation(fields: [familyId], references: [id], onDelete: Restrict)
  regularCourse    Course?          @relation("StudentRegularCourse", fields: [regularCourseId], references: [id], onDelete: SetNull)
  additionalCourse Course?          @relation("StudentAdditionalCourse", fields: [additionalCourseId], references: [id], onDelete: SetNull)
  teacher          Teacher?         @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  statusChangedBy  User?            @relation("StudentStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: SetNull)
  archivedBy       User?            @relation("StudentArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  enrollments      Enrollment[]
  sessions         ClassSession[]
  sessionRequests  SessionRequest[]
  lessonReports    LessonReport[]
  hifzEntries      HifzEntry[]
  studentTests     StudentTest[]

  // N6 billing
  feePackage   StudentFeePackage?
  invoiceLines InvoiceLine[]

  trialOffers TrialOffer[]

  @@index([familyId])
  @@index([teacherId])
  @@index([status])
  @@index([archivedAt])
  @@map("students")
}

/// A teacher = one teacher login (`user_id`) + profile. Email and phone live on the user.
model Teacher {
  id                Int             @id @default(autoincrement())
  userId            Int             @unique @map("user_id")
  firstName         String          @map("first_name") @db.VarChar(60)
  lastName          String?         @map("last_name") @db.VarChar(60)
  altPhone          String?         @map("alt_phone") @db.VarChar(16)
  gender            Gender?
  nationality       String?         @db.VarChar(60)
  countryCode       String?         @map("country_code") @db.Char(2)
  timezone          String          @db.VarChar(64)
  age               Int?            @db.SmallInt
  qualification     String?
  experience        String?
  address           String?         @db.VarChar(500)
  skypeId           String?         @map("skype_id") @db.VarChar(100)
  description       String?
  status            ActiveStatus    @default(active)
  statusReason      String?         @map("status_reason") @db.VarChar(500)
  statusChangedAt   DateTime?       @map("status_changed_at") @db.Timestamptz(6)
  statusChangedById Int?            @map("status_changed_by")
  archivedAt        DateTime?       @map("archived_at") @db.Timestamptz(6)
  archivedById      Int?            @map("archived_by")
  archiveReason     String?         @map("archive_reason") @db.VarChar(500)
  // T2 trial eligibility (docs/33 §4.1)
  acceptsTrials     Boolean         @default(true) @map("accepts_trials")
  /// null = no weekly cap.
  maxTrialsPerWeek  Int?            @map("max_trials_per_week") @db.SmallInt
  audience          TeacherAudience @default(both)
  /// Languages the teacher teaches in (`TEACHER_LANGUAGES`).
  languages         String[]        @default([]) @db.VarChar(16)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  // N4 support centre
  tickets Ticket[]

  user            User              @relation("TeacherUser", fields: [userId], references: [id], onDelete: Restrict)
  statusChangedBy User?             @relation("TeacherStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: SetNull)
  archivedBy      User?             @relation("TeacherArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  courses         TeacherCourse[]
  students        Student[]
  enrollments     Enrollment[]
  slots           ScheduleSlot[]
  sessions        ClassSession[]
  blocks          TeacherBlock[]
  workHours       TeacherWorkHour[]
  zoomHosts       ZoomHost[]
  lessonReports   LessonReport[]
  tests           StudentTest[]

  // N7: the hourly rate lives on the pay profile (D89); back-relations.
  payProfile PayProfile?
  payslips   Payslip[]

  trialOfferInvites  TrialOfferTeacher[]
  trialOffersClaimed TrialOffer[]        @relation("TrialOfferClaimedBy")

  @@index([status])
  @@index([archivedAt])
  @@map("teachers")
}

model TeacherCourse {
  teacherId Int @map("teacher_id")
  courseId  Int @map("course_id")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([teacherId, courseId])
  @@index([courseId])
  @@map("teacher_courses")
}

/// Status history of families, students, teachers and staff (who, when, why; docs/06 §5).
model StatusChange {
  id          Int        @id @default(autoincrement())
  subjectType PersonType @map("subject_type")
  subjectId   Int        @map("subject_id")
  fromStatus  String?    @map("from_status") @db.VarChar(32)
  toStatus    String     @map("to_status") @db.VarChar(32)
  reason      String?    @db.VarChar(500)
  changedById Int?       @map("changed_by")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([subjectType, subjectId])
  @@map("status_changes")
}

/// Who did what to which record, with the values before and after (docs/29, docs/28).
model AuditLog {
  id          Int      @id @default(autoincrement())
  actorId     Int?     @map("actor_id")
  /// e.g. `created`, `updated`, `status_changed`, `archived`, `unarchived`, `role_created`.
  action      String   @db.VarChar(64)
  subjectType String   @map("subject_type") @db.VarChar(64)
  subjectId   Int?     @map("subject_id")
  before      Json?
  after       Json?
  reason      String?  @db.VarChar(500)
  ip          String?  @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([subjectType, subjectId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Typed key/value settings with defaults in code (port of Laravel `Settings::DEFAULTS`).
model AppSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedById Int?     @map("updated_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("app_settings")
}

// ====================================================================== N2: schedule and classes
// Ported from the Laravel M2 module (docs/14, docs/04, docs/10). Times are UTC instants
// (`timestamptz`); weekly slots keep the local wall time + IANA zone (D38) so DST is exact.

enum EnrollmentStatus {
  active
  paused
  ended
}

/// What a class is (docs/14 §3.1). Set at creation, never changes. Enrollments use regular / trial.
enum SessionKind {
  regular
  trial
  rescheduled
  advance
  extra
}

/// What happened to a class (docs/14 §3.1, docs/04 status codes).
enum SessionStage {
  scheduled
  activated
  in_progress
  ended
  taken
  absent
  declined
  leave
  cancelled
  moved_out
}

enum SessionSource {
  generated
  manual
  request
  migrated
}

enum MeetingMode {
  zoom
  external
}

enum ZoomStatus {
  none
  pending
  ready
  failed
  external
  deleted
}

enum SessionRequestType {
  leave
  reschedule
  advance
  extra
}

enum SessionRequestStatus {
  pending
  approved
  auto_approved
  rejected
  cancelled
  expired
}

enum TeacherBlockKind {
  recurring
  one_off
}

/// One student studying one course with one teacher (docs/14 §2.2). At most one live (active or
/// paused) enrollment per student and course: a partial unique index in the migration.
model Enrollment {
  id                 Int              @id @default(autoincrement())
  studentId          Int              @map("student_id")
  courseId           Int              @map("course_id")
  teacherId          Int              @map("teacher_id")
  kind               SessionKind      @default(regular)
  status             EnrollmentStatus @default(active)
  /// family_suspended | family_on_leave | admin (while paused).
  pausedReason       String?          @map("paused_reason") @db.VarChar(32)
  startsOn           DateTime         @map("starts_on") @db.Date
  endsOn             DateTime?        @map("ends_on") @db.Date
  sessionMinutes     Int              @default(30) @map("session_minutes") @db.SmallInt
  /// The student's (family's) zone when the enrollment was made; new slots use it.
  timezone           String           @db.VarChar(64)
  meetingMode        MeetingMode      @default(zoom) @map("meeting_mode")
  /// Encrypted at rest (AES-256-GCM, `APP_ENCRYPTION_KEY`): `v1:` + base64.
  externalMeetingUrl String?          @map("external_meeting_url")
  notes              String?
  statusChangedAt    DateTime?        @map("status_changed_at") @db.Timestamptz(6)
  createdById        Int?             @map("created_by")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  student   Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teacher   Teacher          @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  createdBy User?            @relation("EnrollmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  slots     ScheduleSlot[]
  sessions  ClassSession[]
  requests  SessionRequest[]

  @@index([studentId, status])
  @@index([teacherId, status])
  @@index([courseId])
  @@map("enrollments")
}

/// A weekly recurring class: ISO weekday (1 = Monday) + local wall time in `timezone` (D38).
/// Never edited in place: a change closes this row (`valid_to`) and opens a new one (docs/14 §2.3).
model ScheduleSlot {
  id              Int       @id @default(autoincrement())
  enrollmentId    Int       @map("enrollment_id")
  teacherId       Int       @map("teacher_id")
  weekday         Int       @db.SmallInt
  /// `HH:MM`, local wall time in `timezone`.
  localStartTime  String    @map("local_start_time") @db.Char(5)
  durationMinutes Int       @map("duration_minutes") @db.SmallInt
  timezone        String    @db.VarChar(64)
  validFrom       DateTime  @map("valid_from") @db.Date
  validTo         DateTime? @map("valid_to") @db.Date
  createdById     Int?      @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  teacher    Teacher        @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  sessions   ClassSession[]

  @@index([teacherId, weekday])
  @@index([enrollmentId, validTo])
  @@map("schedule_slots")
}

/// Academy holidays: academy-local dates (`date` .. `ends_on`). Classes on them are cancelled.
model Holiday {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  date      DateTime  @db.Date
  endsOn    DateTime? @map("ends_on") @db.Date
  paid      Boolean   @default(true)
  appliesTo String    @default("all") @map("applies_to") @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([date])
  @@map("holidays")
}

/// Recurring ("block schedule") or one-off teacher unavailability (docs/14 §2.7).
model TeacherBlock {
  id              Int              @id @default(autoincrement())
  teacherId       Int              @map("teacher_id")
  kind            TeacherBlockKind
  /// break | other_job | leave | admin_hold | other
  reason          String           @default("other") @db.VarChar(16)
  weekday         Int?             @db.SmallInt
  localStartTime  String?          @map("local_start_time") @db.Char(5)
  durationMinutes Int?             @map("duration_minutes") @db.SmallInt
  timezone        String?          @db.VarChar(64)
  validFrom       DateTime?        @map("valid_from") @db.Date
  validTo         DateTime?        @map("valid_to") @db.Date
  startsAt        DateTime?        @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime?        @map("ends_at") @db.Timestamptz(6)
  note            String?          @db.VarChar(500)
  createdById     Int?             @map("created_by")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, kind])
  @@map("teacher_blocks")
}

/// The teacher's published weekly working hours (docs/14 §2.7). No rows = not set.
model TeacherWorkHour {
  id             Int      @id @default(autoincrement())
  teacherId      Int      @map("teacher_id")
  weekday        Int      @db.SmallInt
  localStartTime String   @map("local_start_time") @db.Char(5)
  localEndTime   String   @map("local_end_time") @db.Char(5)
  timezone       String   @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, weekday])
  @@map("teacher_work_hours")
}

/// A licensed Zoom user that may host class meetings (D43). No real Zoom calls until B7.
model ZoomHost {
  id         Int      @id @default(autoincrement())
  zoomUserId String   @unique @map("zoom_user_id") @db.VarChar(64)
  email      String   @db.VarChar(255)
  label      String?  @db.VarChar(100)
  /// A teacher's dedicated host; null = pool host.
  teacherId  Int?     @map("teacher_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher  Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  sessions ClassSession[]

  @@map("zoom_hosts")
}

/// One class occurrence (D37, docs/14 §2.4). Time = `starts_at` + `duration_minutes` (UTC);
/// state = `kind` + `stage`. The generator's key (schedule_slot_id, occurrence_date) is unique,
/// soft-deleted rows included, so a removed class is never generated again.
model ClassSession {
  id              Int           @id @default(autoincrement())
  enrollmentId    Int?          @map("enrollment_id")
  scheduleSlotId  Int?          @map("schedule_slot_id")
  /// The slot's local date (student zone) this row was generated for.
  occurrenceDate  DateTime?     @map("occurrence_date") @db.Date
  teacherId       Int           @map("teacher_id")
  studentId       Int           @map("student_id")
  courseId        Int?          @map("course_id")
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(6)
  durationMinutes Int           @map("duration_minutes") @db.SmallInt
  kind            SessionKind   @default(regular)
  stage           SessionStage  @default(scheduled)
  /// leave: student | teacher; cancelled: holiday | family_suspended | …; moved_out: rescheduled | advanced.
  stageReason     String?       @map("stage_reason") @db.VarChar(32)
  originSessionId Int?          @map("origin_session_id")
  source          SessionSource @default(manual)
  /// Shifted by hand: the generator's re-sync leaves it alone.
  isDetached      Boolean       @default(false) @map("is_detached")
  activatedAt     DateTime?     @map("activated_at") @db.Timestamptz(6)
  startedAt       DateTime?     @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime?     @map("ended_at") @db.Timestamptz(6)
  markedAt        DateTime?     @map("marked_at") @db.Timestamptz(6)
  markedById      Int?          @map("marked_by")
  needsReview     Boolean       @default(false) @map("needs_review")
  reviewReason    String?       @map("review_reason") @db.VarChar(32)
  zoomStatus      ZoomStatus    @default(none) @map("zoom_status")
  zoomMeetingId   String?       @map("zoom_meeting_id") @db.VarChar(32)
  zoomHostId      Int?          @map("zoom_host_id")
  /// Encrypted at rest (AES-256-GCM). Never sent in a class payload; only decrypted by
  /// `/zoom/start` (own teacher) and `/zoom/join` inside their windows.
  zoomJoinUrl     String?       @map("zoom_join_url")
  zoomError       String?       @map("zoom_error") @db.VarChar(255)
  actualStartedAt DateTime?     @map("actual_started_at") @db.Timestamptz(6)
  actualEndedAt   DateTime?     @map("actual_ended_at") @db.Timestamptz(6)
  teacherJoinedAt DateTime?     @map("teacher_joined_at") @db.Timestamptz(6)
  studentJoinedAt DateTime?     @map("student_joined_at") @db.Timestamptz(6)
  /// N7 pay snapshot (D41/D56), written when the stage is decided, cleared when it is undone.
  /// pay hours = rule factor × duration / 60.
  payHours        Decimal?      @map("pay_hours") @db.Decimal(5, 2)
  payRuleKey      String?       @map("pay_rule_key") @db.VarChar(40)
  payRuleSetId    Int?          @map("pay_rule_set_id")
  billable        Boolean?
  /// Optimistic concurrency: +1 on every write (409 stale_session on a mismatch).
  lockVersion     Int           @default(0) @map("lock_version")
  createdById     Int?          @map("created_by")
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Written from the app clock on every change (the board's `since` cursor reads it).
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  enrollment     Enrollment?      @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  slot           ScheduleSlot?    @relation(fields: [scheduleSlotId], references: [id], onDelete: SetNull)
  teacher        Teacher          @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course         Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  origin         ClassSession?    @relation("SessionOrigin", fields: [originSessionId], references: [id], onDelete: SetNull)
  derived        ClassSession[]   @relation("SessionOrigin")
  markedBy       User?            @relation("SessionMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  zoomHost       ZoomHost?        @relation(fields: [zoomHostId], references: [id], onDelete: SetNull)
  events         SessionEvent[]
  requests       SessionRequest[] @relation("SessionRequestSession")
  resultRequests SessionRequest[] @relation("SessionRequestResult")
  report         LessonReport?

  // N7 payroll back-relations.
  payRuleSet     PayRuleSet?     @relation(fields: [payRuleSetId], references: [id], onDelete: SetNull)
  payAdjustments PayAdjustment[]

  trialOffers TrialOffer[]

  @@unique([scheduleSlotId, occurrenceDate], map: "class_sessions_slot_occurrence_key")
  @@index([startsAt])
  @@index([teacherId, startsAt])
  @@index([studentId, startsAt])
  @@index([enrollmentId, startsAt])
  @@index([stage, startsAt])
  @@index([updatedAt, id])
  @@index([zoomMeetingId])
  @@map("class_sessions")
}

/// Append-only per-class timeline (docs/14 §2.5): a trigger refuses UPDATE and DELETE.
model SessionEvent {
  id          Int      @id @default(autoincrement())
  sessionId   Int      @map("session_id")
  /// generated | activated | marked | reverted | cancelled | moved_out | time_changed | teacher_changed | zoom_* | note …
  type        String   @db.VarChar(32)
  fromStage   String?  @map("from_stage") @db.VarChar(20)
  toStage     String?  @map("to_stage") @db.VarChar(20)
  actorUserId Int?     @map("actor_user_id")
  actorRole   String?  @map("actor_role") @db.VarChar(100)
  payload     Json?
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(3)

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  actor   User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([sessionId, occurredAt])
  @@index([type, occurredAt])
  @@map("session_events")
}

/// Leave / reschedule / advance / extra request (docs/14 §2.6, §3.4). At most one pending
/// request of a type per class: a partial unique index in the migration.
model SessionRequest {
  id                      Int                  @id @default(autoincrement())
  type                    SessionRequestType
  sessionId               Int                  @map("session_id")
  enrollmentId            Int?                 @map("enrollment_id")
  studentId               Int                  @map("student_id")
  requestedById           Int                  @map("requested_by")
  requesterRole           String?              @map("requester_role") @db.VarChar(100)
  reason                  String
  notifiedAt              DateTime?            @map("notified_at") @db.Timestamptz(6)
  proposedStartsAt        DateTime?            @map("proposed_starts_at") @db.Timestamptz(6)
  proposedDurationMinutes Int?                 @map("proposed_duration_minutes") @db.SmallInt
  proposedTeacherId       Int?                 @map("proposed_teacher_id")
  status                  SessionRequestStatus @default(pending)
  decidedById             Int?                 @map("decided_by")
  decidedAt               DateTime?            @map("decided_at") @db.Timestamptz(6)
  decisionNote            String?              @map("decision_note")
  resultSessionId         Int?                 @map("result_session_id")
  lockVersion             Int                  @default(0) @map("lock_version")
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)

  session       ClassSession  @relation("SessionRequestSession", fields: [sessionId], references: [id], onDelete: Restrict)
  resultSession ClassSession? @relation("SessionRequestResult", fields: [resultSessionId], references: [id], onDelete: SetNull)
  enrollment    Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  requestedBy   User          @relation("SessionRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy     User?         @relation("SessionRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([studentId, status])
  @@index([sessionId])
  @@index([requestedById])
  @@map("session_requests")
}

// ====================================================================== N3: teaching
// Lesson reports, hifz progress and student tests, ported from the Laravel M3 module
// (docs/14 §2.11, docs/27, D70–D72, D113–D120).

/// sabaq = new lesson, sabaqi = recent revision, manzil = old revision.
enum HifzType {
  sabaq
  sabaqi
  manzil
}

enum HifzGrade {
  excellent
  very_good
  good
  needs_work
  not_memorised
}

/// What a student test examines (old `dept_id` 1 Qaida, 2 Nazra, 3 Hifz; docs/27 §3).
enum TestTrack {
  qaida
  nazra
  hifz
}

/// Lifecycle of a student test (docs/27 §5, D117).
enum TestStatus {
  scheduled
  taken
  refused
  cancelled
}

/// The Quran reference (Hafs numbering), seeded by the migration from `@qarabic/shared` QURAN_SURAHS.
model QuranSurah {
  number    Int    @id @db.SmallInt
  nameAr    String @map("name_ar") @db.VarChar(64)
  nameEn    String @map("name_en") @db.VarChar(64)
  ayahCount Int    @map("ayah_count") @db.SmallInt
  juzStart  Int    @map("juz_start") @db.SmallInt

  @@map("quran_surahs")
}

/// The teacher's report of one class (D45, D70; docs/14 §2.11). Writing it on an `ended` class
/// moves the class to `taken`. `teacher_notes` are internal (never sent to a parent).
model LessonReport {
  id            Int      @id @default(autoincrement())
  sessionId     Int      @unique @map("session_id")
  studentId     Int      @map("student_id")
  teacherId     Int      @map("teacher_id")
  /// What was done in class; the parent reads it.
  summary       String
  homework      String?
  tajweedNotes  String?  @map("tajweed_notes")
  /// Internal note for staff (Laravel `teacher_notes`).
  teacherNotes  String?  @map("teacher_notes")
  /// 1–5 (Laravel `behaviour`); parents see it unless `reports.parent_sees_rating` is off (B30).
  rating        Int?     @db.SmallInt
  /// End of the class + `sessions.report_due_hours` at the first submission.
  dueAt         DateTime @map("due_at") @db.Timestamptz(6)
  submittedLate Boolean  @default(false) @map("submitted_late")
  submittedById Int?     @map("submitted_by")
  submittedAt   DateTime @map("submitted_at") @db.Timestamptz(6)
  updatedById   Int?     @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Written from the app clock on every edit.
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  session     ClassSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  submittedBy User?        @relation("LessonReportSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  updatedBy   User?        @relation("LessonReportUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  hifz        HifzEntry[]

  @@index([studentId, submittedAt])
  @@index([teacherId, submittedAt])
  @@map("lesson_reports")
}

/// Structured hifz of a report by surah and ayah (docs/14 §2.11). Rewritten with the report.
model HifzEntry {
  id        Int        @id @default(autoincrement())
  reportId  Int        @map("lesson_report_id")
  sessionId Int        @map("session_id")
  studentId Int        @map("student_id")
  /// Order inside the report.
  position  Int        @default(0) @db.SmallInt
  type      HifzType
  fromSurah Int        @map("from_surah") @db.SmallInt
  fromAyah  Int        @map("from_ayah") @db.SmallInt
  toSurah   Int        @map("to_surah") @db.SmallInt
  toAyah    Int        @map("to_ayah") @db.SmallInt
  /// Ayahs covered (computed on write).
  ayahs     Int        @db.SmallInt
  /// Mushaf pages, optional (quarter pages).
  pages     Decimal?   @db.Decimal(5, 2)
  grade     HifzGrade?
  mistakes  Int?       @db.SmallInt
  notes     String?    @db.VarChar(500)
  /// The class start (copied): progress orders and buckets by when the lesson happened.
  lessonAt  DateTime   @map("lesson_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  report  LessonReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@index([studentId, type, lessonAt])
  @@map("hifz_entries")
}

/// A student test (docs/27 §4, D113): not a class; an examiner teacher at a UTC instant. Scores
/// are percentages (D115). One scheduled test per student and track: a partial unique index.
model StudentTest {
  id              Int        @id @default(autoincrement())
  studentId       Int        @map("student_id")
  /// The examiner.
  teacherId       Int        @map("teacher_id")
  courseId        Int?       @map("course_id")
  track           TestTrack
  /// Tajweed section keys (TEST_SECTIONS order).
  sections        String[]
  scheduledAt     DateTime   @map("scheduled_at") @db.Timestamptz(6)
  durationMinutes Int        @default(30) @map("duration_minutes") @db.SmallInt
  /// The student's zone when the test was scheduled.
  studentTimezone String     @map("student_timezone") @db.VarChar(64)
  notes           String?
  status          TestStatus @default(scheduled)
  statusReason    String?    @map("status_reason") @db.VarChar(500)
  tajweedScore    Int?       @map("tajweed_score") @db.SmallInt
  readingScore    Int?       @map("reading_score") @db.SmallInt
  hifzScore       Int?       @map("hifz_score") @db.SmallInt
  overallScore    Int?       @map("overall_score") @db.SmallInt
  /// Mistake codes 1–26, sorted.
  mistakes        Int[]      @default([])
  /// Shown to the parent.
  remarks         String?
  /// Staff and teachers only.
  internalNotes   String?    @map("internal_notes")
  /// 0–100, staff only (B67).
  teacherRating   Int?       @map("teacher_rating") @db.SmallInt
  recordedAt      DateTime?  @map("recorded_at") @db.Timestamptz(6)
  recordedById    Int?       @map("recorded_by")
  createdById     Int?       @map("created_by")
  decidedById     Int?       @map("decided_by")
  decidedAt       DateTime?  @map("decided_at") @db.Timestamptz(6)
  /// The old `test_results.test_id` (import, later).
  legacyId        Int?       @unique @map("legacy_id")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)

  student    Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher    Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  course     Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  recordedBy User?   @relation("StudentTestRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdBy  User?   @relation("StudentTestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  decidedBy  User?   @relation("StudentTestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([teacherId, scheduledAt])
  @@index([studentId, scheduledAt])
  @@map("student_tests")
}

// ====================================================================== N4: support centre
// «تواصل معنا» tickets, their timeline and files, and the WhatsApp intake log (docs/22, docs/32,
// D99, D102, D135). Ported from the Laravel Feedback module (`feedback_tickets` …). Queues, their
// member roles, SLA targets and the working week are settings (`support.*` in app_settings).

enum TicketType {
  bug
  feature
}

enum TicketCategory {
  classes
  teacher
  billing
  technical
  suggestion
  other
}

enum TicketChannel {
  in_app
  whatsapp
  staff
  phone
}

enum TicketPriority {
  p0
  p1
  p2
  p3
}

enum TicketStatus {
  new
  triaged
  in_progress
  needs_info
  fixed
  verified
  wont_fix
}

enum TicketSubjectType {
  session
  invoice
  student
}

enum TicketQueue {
  scheduling
  billing
  complaints
  tech
  product
  general
}

enum TicketVisibility {
  normal
  restricted
}

/// S3 typed requests (docs/32 §3 #4–#7): see `REQUEST_STATES`.
enum TicketRequestState {
  submitted
  proposed
  accepted
  declined
  approved
  rejected
  done
}

enum TicketCommentKind {
  comment
  status
  priority
  assignment
  system
}

enum TicketAttachmentSource {
  screenshot
  upload
  whatsapp
}

/// A «تواصل معنا» ticket (docs/22 §2, docs/32 §4). Shown to people as `#id`.
model Ticket {
  id                  Int                 @id @default(autoincrement())
  channel             TicketChannel       @default(in_app)
  type                TicketType
  category            TicketCategory
  /// Fixed allow-list per category (`TICKET_SUBCATEGORIES`).
  subcategory         String?             @db.VarChar(40)
  subjectType         TicketSubjectType?  @map("subject_type")
  subjectId           Int?                @map("subject_id")
  queue               TicketQueue
  /// restricted = complaints: the reporter and support.view_restricted only, never the teacher concerned.
  visibility          TicketVisibility    @default(normal)
  familyId            Int?                @map("family_id")
  teacherId           Int?                @map("teacher_id")
  /// First-response deadline in working hours, capped by the class start (docs/32 §5).
  slaDueAt            DateTime?           @map("sla_due_at") @db.Timestamptz(6)
  firstResponseAt     DateTime?           @map("first_response_at") @db.Timestamptz(6)
  slaBreachNotifiedAt DateTime?           @map("sla_breach_notified_at") @db.Timestamptz(6)
  priority            TicketPriority?
  status              TicketStatus        @default(new)
  title               String              @db.VarChar(160)
  description         String
  reporterId          Int?                @map("reporter_id")
  reporterRole        String?             @map("reporter_role") @db.VarChar(100)
  /// WhatsApp sender, encrypted at rest (AES-256-GCM); never sent to any client.
  contactPhone        String?             @map("contact_phone")
  /// HMAC of the sender's digits: groups an unknown sender's messages without storing the number in clear.
  contactHash         String?             @map("contact_hash") @db.Char(64)
  area                String?             @db.VarChar(40)
  /// Sanitised client context (page, app version, zone, recent API errors): no form values or tokens.
  context             Json?
  prUrl               String?             @map("pr_url") @db.VarChar(300)
  resolution          String?
  duplicateOfId       Int?                @map("duplicate_of_id")
  assigneeId          Int?                @map("assignee_id")
  triagedAt           DateTime?           @map("triaged_at") @db.Timestamptz(6)
  fixedAt             DateTime?           @map("fixed_at") @db.Timestamptz(6)
  verifiedAt          DateTime?           @map("verified_at") @db.Timestamptz(6)
  closedAt            DateTime?           @map("closed_at") @db.Timestamptz(6)
  /// Last change the reporter can see; `reporter_seen_at` older = "has an update".
  lastPublicAt        DateTime?           @map("last_public_at") @db.Timestamptz(6)
  reporterSeenAt      DateTime?           @map("reporter_seen_at") @db.Timestamptz(6)
  whatsappWindowUntil DateTime?           @map("whatsapp_window_until") @db.Timestamptz(6)
  /// S3: the structured payload of a typed request (by `subcategory`); null for a plain ticket.
  request             Json?
  requestState        TicketRequestState? @map("request_state")
  /// Teacher change: `{ teacherId, fromDate }` proposed by staff.
  proposal            Json?
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Written from the app clock on every change.
  updatedAt           DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)

  reporter    User?              @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignee    User?              @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  family      Family?            @relation(fields: [familyId], references: [id], onDelete: SetNull)
  teacher     Teacher?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  duplicateOf Ticket?            @relation("TicketDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  Ticket[]           @relation("TicketDuplicate")
  comments    TicketComment[]
  attachments TicketAttachment[]

  @@index([status, priority])
  @@index([queue, status])
  @@index([reporterId, status])
  @@index([assigneeId])
  @@index([familyId])
  @@index([teacherId])
  @@index([slaDueAt])
  @@index([contactHash])
  @@map("tickets")
}

/// One timeline row: a comment or a status / priority / assignment / system change.
model TicketComment {
  id          Int               @id @default(autoincrement())
  ticketId    Int               @map("ticket_id")
  authorId    Int?              @map("author_id")
  /// "Claude" (CLI) or the WhatsApp sender when there is no user.
  authorLabel String?           @map("author_label") @db.VarChar(60)
  kind        TicketCommentKind @default(comment)
  body        String?
  /// Staff only (internal notes, assignment / priority changes).
  internal    Boolean           @default(false)
  meta        Json?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  attachments TicketAttachment[]

  @@index([ticketId, id])
  @@map("ticket_comments")
}

/// A private file (screenshot, upload, WhatsApp media) in the file storage (local disk / S3 later).
model TicketAttachment {
  id           Int                    @id @default(autoincrement())
  ticketId     Int                    @map("ticket_id")
  commentId    Int?                   @map("comment_id")
  source       TicketAttachmentSource
  /// Storage key: `tickets/{ticket}/{uuid}.{ext}` (random, never the client's name).
  storageKey   String                 @map("storage_key") @db.VarChar(255)
  mime         String                 @db.VarChar(100)
  size         Int
  sha256       String                 @db.Char(64)
  originalName String?                @map("original_name") @db.VarChar(150)
  prunedAt     DateTime?              @map("pruned_at") @db.Timestamptz(6)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket  Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment TicketComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("ticket_attachments")
}

/// WhatsApp Cloud API intake log (docs/22 §5.2): one row per message id (Meta retries are ignored).
model WhatsAppInboundMessage {
  id          Int      @id @default(autoincrement())
  waMessageId String   @unique @map("wa_message_id") @db.VarChar(191)
  /// HMAC of the sender's digits, never the number itself.
  fromHash    String   @map("from_hash") @db.Char(64)
  /// text | image | audio | document | other
  type        String   @db.VarChar(16)
  /// received | ticket_created | appended | ignored_unknown | ignored_type
  status      String   @db.VarChar(32)
  userId      Int?     @map("user_id")
  ticketId    Int?     @map("ticket_id")
  error       String?  @db.VarChar(200)
  receivedAt  DateTime @map("received_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@map("whatsapp_inbound_messages")
}

// ====================================================================== N5: CRM
// Leads, their timeline and the staff alerts (docs/26, docs/33 §3; D105–D111, D136, D137).
// Ported from the Laravel M4 CRM (`leads`, `lead_activities`). A referral is a lead with
// `source=referral` + `referral_family_id`; a lead's trial classes are the `kind=trial` classes
// of its family's students (Laravel does the same). The rules live in `crm.*` settings.

/// Pipeline stage (D106).
enum LeadStatus {
  new
  contacted
  trial_scheduled
  trial_done
  converted
  lost
  spam
  job_applicant
}

enum LeadSource {
  web_form
  phone
  whatsapp
  walk_in
  referral
  other
}

enum LostReason {
  not_interested
  no_response
  price
  schedule
  duplicate
  other
}

enum TrialOutcome {
  interested
  not_interested
  no_show
}

enum LeadActivityType {
  note
  call
  whatsapp
  email
  status_changed
  assigned
  account_created
  trial_booked
  trial_cancelled
  trial_outcome
  converted
  resubmitted
  created
}

/// A prospective family (docs/26 §3.1). Contact data is kept as submitted; `phone_digits`
/// (digits, leading zeros dropped, last 15) is what duplicates match on.
model Lead {
  id                  Int           @id @default(autoincrement())
  status              LeadStatus    @default(new)
  source              LeadSource    @default(web_form)
  /// `app_trial` (the app's form), `wpforms:4823` (the website), or an old form's value.
  site                String?       @db.VarChar(40)
  parentName          String        @map("parent_name") @db.VarChar(120)
  email               String?       @db.VarChar(190)
  phone               String?       @db.VarChar(40)
  phoneDigits         String?       @map("phone_digits") @db.VarChar(15)
  countryCode         String?       @map("country_code") @db.Char(2)
  city                String?       @db.VarChar(80)
  /// IANA zone of the family (the country's main zone until staff change it).
  timezone            String        @db.VarChar(64)
  preferredLanguage   String?       @map("preferred_language") @db.VarChar(8)
  /// `[{ name?, age?, gender?, courseId? }]`
  children            Json          @default("[]")
  courseInterest      String?       @map("course_interest") @db.VarChar(120)
  preferredTimes      String?       @map("preferred_times") @db.VarChar(500)
  /// `{ days: [1..7], periods: [...], note? }` from the app's trial form.
  preferredSchedule   Json?         @map("preferred_schedule")
  teacherGenderPref   String?       @map("teacher_gender_pref") @db.VarChar(8)
  heardFrom           String?       @map("heard_from") @db.VarChar(16)
  message             String?
  utm                 Json?
  /// Idempotency key of an external intake (`wpforms:<form>:<entry>`).
  externalRef         String?       @unique @map("external_ref") @db.VarChar(100)
  referralFamilyId    Int?          @map("referral_family_id")
  familyId            Int?          @map("family_id")
  assignedToId        Int?          @map("assigned_to")
  assignedAt          DateTime?     @map("assigned_at") @db.Timestamptz(6)
  /// Set when the round-robin (or the lead-admin fallback) gave the lead its owner.
  autoAssignedAt      DateTime?     @map("auto_assigned_at") @db.Timestamptz(6)
  createdById         Int?          @map("created_by")
  nextFollowUpAt      DateTime?     @map("next_follow_up_at") @db.Timestamptz(6)
  /// The follow-up time already reminded (a new `next_follow_up_at` arms the reminder again).
  followUpNotifiedFor DateTime?     @map("follow_up_notified_for") @db.Timestamptz(6)
  lastContactedAt     DateTime?     @map("last_contacted_at") @db.Timestamptz(6)
  firstResponseAt     DateTime?     @map("first_response_at") @db.Timestamptz(6)
  slaNotifiedAt       DateTime?     @map("sla_notified_at") @db.Timestamptz(6)
  contactAttempts     Int           @default(0) @map("contact_attempts")
  trialOutcome        TrialOutcome? @map("trial_outcome")
  lostReason          LostReason?   @map("lost_reason")
  statusNote          String?       @map("status_note") @db.VarChar(1000)
  statusChangedAt     DateTime      @map("status_changed_at") @db.Timestamptz(6)
  convertedAt         DateTime?     @map("converted_at") @db.Timestamptz(6)
  convertedById       Int?          @map("converted_by")
  spamScore           Int           @default(0) @map("spam_score") @db.SmallInt
  spamFlags           Json?         @map("spam_flags")
  /// sha256 of the sender's IP + app secret (burst detection), never the IP itself.
  ipHash              String?       @map("ip_hash") @db.Char(64)
  /// Submissions merged into this lead (1 = only the first).
  submissions         Int           @default(1)
  createdAt           DateTime      @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @map("updated_at") @db.Timestamptz(6)

  family         Family?        @relation("LeadFamily", fields: [familyId], references: [id], onDelete: SetNull)
  referralFamily Family?        @relation("LeadReferralFamily", fields: [referralFamilyId], references: [id], onDelete: SetNull)
  assignedTo     User?          @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy      User?          @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  convertedBy    User?          @relation("LeadConvertedBy", fields: [convertedById], references: [id], onDelete: SetNull)
  activities     LeadActivity[]

  trialOffers TrialOffer[]

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([email])
  @@index([phoneDigits])
  @@index([familyId])
  @@index([nextFollowUpAt])
  @@index([ipHash, createdAt])
  @@map("leads")
}

/// Append-only timeline of a lead (docs/26 §3.2): a trigger refuses UPDATE and DELETE.
model LeadActivity {
  id         Int              @id @default(autoincrement())
  leadId     Int              @map("lead_id")
  type       LeadActivityType
  body       String?
  /// reached | no_answer | busy | wrong_number
  callResult String?          @map("call_result") @db.VarChar(16)
  meta       Json?
  userId     Int?             @map("user_id")
  createdAt  DateTime         @map("created_at") @db.Timestamptz(3)

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, id])
  @@index([type])
  @@map("lead_activities")
}

/// In-app alert for one user (Laravel `notifications`, database channel): the bell reads it.
/// `kind` names the module (`lead`), `event` what happened; `data` never holds contact details.
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  kind      String    @db.VarChar(32)
  event     String    @db.VarChar(32)
  data      Json
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ====================================================================== N6: billing
// Fee packages, the family billing profile, invoices, payments and the ledger outbox (docs/20,
// D83–D88, D140). Ported from the Laravel M5 billing tables. Money is `numeric(12,2)` + an ISO
// 4217 currency (never a float); the services work in integer minor units. Invoice lines are
// append-only (a trigger refuses UPDATE / DELETE); adjustments and discounts are new lines.

enum InvoiceKind {
  monthly
  manual
  split
}

/// "Overdue" is not stored: an open invoice whose due date has passed (academy zone).
enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  void
  split
}

enum InvoiceLineType {
  package
  manual
  adjustment
  discount
  split
}

enum PaymentMethod {
  stripe
  paypal
  cash
  bank_transfer
  cheque
  other
}

enum PaymentStatus {
  pending
  succeeded
  failed
  cancelled
  refunded
}

enum WebhookEventStatus {
  received
  processed
  ignored
  failed
}

/// A monthly fee for a weekly plan (e.g. 2 classes a week × 30 min), priced per currency. Archive
/// (`is_active = false`), never delete.
model FeePackage {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(120)
  classesPerWeek Int      @map("classes_per_week") @db.SmallInt
  sessionMinutes Int      @default(30) @map("session_minutes") @db.SmallInt
  description    String?  @db.VarChar(500)
  isActive       Boolean  @default(true) @map("is_active")
  createdById    Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User?               @relation("FeePackageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  prices    FeePackagePrice[]
  students  StudentFeePackage[]
  lines     InvoiceLine[]

  @@index([isActive])
  @@map("fee_packages")
}

model FeePackagePrice {
  id            Int      @id @default(autoincrement())
  feePackageId  Int      @map("fee_package_id")
  currency      String   @db.Char(3)
  monthlyAmount Decimal  @map("monthly_amount") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  feePackage FeePackage @relation(fields: [feePackageId], references: [id], onDelete: Cascade)

  @@unique([feePackageId, currency])
  @@map("fee_package_prices")
}

/// A family's billing profile (D84): currency, cycle day (1 or 15, old `payment_cycle`), billing
/// on/off, a fixed custom fee (old `account.fee`) and the first billed day (proration, D85).
model FamilyBillingProfile {
  familyId    Int       @id @map("family_id")
  currency    String?   @db.Char(3)
  billingDay  Int       @default(1) @map("billing_day") @db.SmallInt
  enabled     Boolean   @default(false)
  customFee   Decimal?  @map("custom_fee") @db.Decimal(12, 2)
  startsOn    DateTime? @map("starts_on") @db.Date
  updatedById Int?      @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  updatedBy User?  @relation("BillingProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("family_billing_profiles")
}

/// The fee package of a child; a change applies from the next invoice (D85).
model StudentFeePackage {
  studentId    Int      @id @map("student_id")
  feePackageId Int      @map("fee_package_id")
  updatedById  Int?     @map("updated_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feePackage FeePackage @relation(fields: [feePackageId], references: [id], onDelete: Restrict)
  updatedBy  User?      @relation("StudentFeePackageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([feePackageId])
  @@map("student_fee_packages")
}

/// A family invoice (D83). Totals and status come only from the recalculation (lines + succeeded
/// payments). `period_key` = "family:{id}:{period_start}" for monthly invoices: one per family and
/// period (cleared on void / split so the period can be billed again).
model Invoice {
  id          Int           @id @default(autoincrement())
  number      String?       @unique @db.VarChar(32)
  familyId    Int           @map("family_id")
  kind        InvoiceKind
  status      InvoiceStatus @default(draft)
  periodStart DateTime?     @map("period_start") @db.Date
  periodEnd   DateTime?     @map("period_end") @db.Date
  periodKey   String?       @unique @map("period_key") @db.VarChar(48)
  currency    String        @db.Char(3)
  subtotal    Decimal       @default(0) @db.Decimal(12, 2)
  adjustments Decimal       @default(0) @db.Decimal(12, 2)
  discounts   Decimal       @default(0) @db.Decimal(12, 2)
  total       Decimal       @default(0) @db.Decimal(12, 2)
  paid        Decimal       @default(0) @db.Decimal(12, 2)
  issueDate   DateTime?     @map("issue_date") @db.Date
  dueDate     DateTime?     @map("due_date") @db.Date
  issuedAt    DateTime?     @map("issued_at") @db.Timestamptz(6)
  issuedById  Int?          @map("issued_by")
  paidAt      DateTime?     @map("paid_at") @db.Timestamptz(6)
  voidedAt    DateTime?     @map("voided_at") @db.Timestamptz(6)
  voidedById  Int?          @map("voided_by")
  voidReason  String?       @map("void_reason") @db.VarChar(500)
  splitFromId Int?          @map("split_from_id")
  notes       String?       @db.VarChar(1000)
  createdById Int?          @map("created_by")
  lockVersion Int           @default(0) @map("lock_version")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  family    Family            @relation(fields: [familyId], references: [id], onDelete: Restrict)
  issuedBy  User?             @relation("InvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  voidedBy  User?             @relation("InvoiceVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  createdBy User?             @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  splitFrom Invoice?          @relation("InvoiceSplit", fields: [splitFromId], references: [id], onDelete: Restrict)
  splits    Invoice[]         @relation("InvoiceSplit")
  lines     InvoiceLine[]
  payments  Payment[]
  reminders InvoiceReminder[]

  @@index([familyId, status])
  @@index([status, dueDate])
  @@index([periodStart])
  @@index([splitFromId])
  @@map("invoices")
}

/// Append-only (trigger): signed amounts, discounts and credit adjustments are negative.
model InvoiceLine {
  id           Int             @id @default(autoincrement())
  invoiceId    Int             @map("invoice_id")
  type         InvoiceLineType
  studentId    Int?            @map("student_id")
  feePackageId Int?            @map("fee_package_id")
  description  String          @db.VarChar(500)
  amount       Decimal         @db.Decimal(12, 2)
  /// Proration (`prorated`, `days`, `periodDays`, `fullAmount`), percent, split part…
  meta         Json?
  createdById  Int?            @map("created_by")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice    Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  student    Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  feePackage FeePackage? @relation(fields: [feePackageId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("InvoiceLineCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([studentId])
  @@map("invoice_lines")
}

/// Gap-free yearly counter for invoice numbers (`INV-2026-000123`), taken under a row lock.
model InvoiceSequence {
  year       Int @id @db.SmallInt
  lastNumber Int @default(0) @map("last_number")

  @@map("invoice_sequences")
}

/// Every attempt or receipt. Online ones are completed only by the provider's confirmed outcome.
model Payment {
  id                Int           @id @default(autoincrement())
  invoiceId         Int           @map("invoice_id")
  familyId          Int           @map("family_id")
  method            PaymentMethod
  status            PaymentStatus @default(pending)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.Char(3)
  /// Stripe Checkout Session id / PayPal order id.
  providerRef       String?       @map("provider_ref") @db.VarChar(191)
  /// Stripe payment_intent / PayPal capture id.
  providerPaymentId String?       @map("provider_payment_id") @db.VarChar(191)
  checkoutUrl       String?       @map("checkout_url")
  /// Manual: receipt / transfer / cheque number.
  reference         String?       @db.VarChar(191)
  note              String?       @db.VarChar(1000)
  receivedAt        DateTime?     @map("received_at") @db.Timestamptz(6)
  refundedAt        DateTime?     @map("refunded_at") @db.Timestamptz(6)
  failureReason     String?       @map("failure_reason") @db.VarChar(500)
  recordedById      Int?          @map("recorded_by")
  initiatedById     Int?          @map("initiated_by")
  idempotencyKey    String?       @unique @map("idempotency_key") @db.VarChar(64)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  family      Family  @relation(fields: [familyId], references: [id], onDelete: Restrict)
  recordedBy  User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  initiatedBy User?   @relation("PaymentInitiatedBy", fields: [initiatedById], references: [id], onDelete: SetNull)

  @@unique([method, providerRef])
  @@index([invoiceId, status])
  @@index([familyId, status])
  @@index([receivedAt])
  @@index([method, providerPaymentId])
  @@map("payments")
}

/// Every verified provider event, unique per (provider, event id) = idempotency (a failed one is
/// retried on the next delivery).
model PaymentWebhookEvent {
  id          Int                @id @default(autoincrement())
  provider    String             @db.VarChar(16)
  eventId     String             @map("event_id") @db.VarChar(191)
  type        String             @db.VarChar(96)
  payload     Json
  status      WebhookEventStatus @default(received)
  error       String?            @db.VarChar(1000)
  processedAt DateTime?          @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@index([status, createdAt])
  @@map("payment_webhook_events")
}

/// Append-only outbox for the accounting ledger (D86): one row per money fact, written in the same
/// transaction. The ledger sets `consumed_at` (the only column that may change).
model BillingEvent {
  id          Int       @id @default(autoincrement())
  /// invoice.issued, invoice.adjusted, invoice.voided, payment.succeeded, payment.refunded
  type        String    @db.VarChar(48)
  subjectType String    @map("subject_type") @db.VarChar(32)
  subjectId   Int       @map("subject_id")
  familyId    Int       @map("family_id")
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @db.Char(3)
  payload     Json?
  occurredAt  DateTime  @map("occurred_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([consumedAt, id])
  @@index([subjectType, subjectId])
  @@map("billing_events")
}

/// One reminder email per invoice and slot (`auto:-3`, `manual:2026120209`): the claim row makes
/// the job idempotent (Laravel used `notifications`).
model InvoiceReminder {
  id        Int      @id @default(autoincrement())
  invoiceId Int      @map("invoice_id")
  slot      String   @db.VarChar(32)
  status    String   @default("sending") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, slot])
  @@map("invoice_reminders")
}

// ====================================================================== N7: payroll
// Ported from the Laravel M6 module (docs/21, D41, D89–D95): pay rules, pay profiles, staff
// attendance and leave, pay adjustments (fines …), monthly payroll runs, payslips, the wallet and
// the payroll outbox. Money = numeric(12,2) + ISO currency; services compute in integer minor
// units. Payroll never moves money (D140): a payment is recorded, not made.

/// Old `profile.Salary` 1–4 (docs/21 §2).
enum SalaryType {
  monthly
  per_class
  hourly
  slot
}

enum AttendanceStatus {
  present
  absent
  leave
  holiday
}

enum AttendanceSource {
  self
  staff
  leave
}

enum LeaveType {
  paid
  unpaid
  sick
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

/// Old `teacher_fine.type` 1–8 plus CSR conversions.
enum AdjustmentType {
  fine
  bonus
  advance
  arrears
  fine_reduction
  gift
  other_addition
  other_deduction
  csr_conversions
}

enum AdjustmentStatus {
  proposed
  approved
  rejected
  cancelled
}

enum PayrollRunStatus {
  draft
  reviewed
  approved
  paid
}

enum PayslipStatus {
  draft
  approved
  paid
}

/// How a payslip was paid out (old system: Vodafone Cash, bank transfer, cash).
enum PayoutMethod {
  vodafone_cash
  bank_transfer
  cash
  other
}

enum WalletTxType {
  salary_credit
  salary_payment
  reversal
}

/// Immutable pay rule version (D41): a change inserts a new set (a trigger refuses UPDATE/DELETE).
/// `rules` = { key: { factor, billable, paidHolidayOnly? } }; the set in force at a class start applies.
model PayRuleSet {
  id            Int      @id @default(autoincrement())
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(6)
  rules         Json
  note          String?  @db.VarChar(255)
  createdById   Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sessions  ClassSession[]

  @@index([effectiveFrom])
  @@map("pay_rule_sets")
}

/// How a staff member or teacher is paid (D89; old `profile` salary fields). One per user.
model PayProfile {
  id            Int        @id @default(autoincrement())
  userId        Int        @unique @map("user_id")
  teacherId     Int?       @unique @map("teacher_id")
  salaryType    SalaryType @default(hourly) @map("salary_type")
  /// Null = the payroll default currency (EGP).
  currency      String?    @db.Char(3)
  monthlySalary Decimal    @default(0) @map("monthly_salary") @db.Decimal(12, 2)
  classRate     Decimal    @default(0) @map("class_rate") @db.Decimal(12, 2)
  hourlyRate    Decimal    @default(0) @map("hourly_rate") @db.Decimal(12, 2)
  csrRate       Decimal    @default(0) @map("csr_rate") @db.Decimal(12, 2)
  allowance     Decimal    @default(0) @db.Decimal(12, 2)
  tax           Decimal    @default(0) @db.Decimal(12, 2)
  /// [{ minSlots, amount }] sorted by minSlots (slot type only).
  slotTiers     Json       @default("[]") @map("slot_tiers")
  active        Boolean    @default(true)
  notes         String?    @db.VarChar(500)
  updatedById   Int?       @map("updated_by")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User     @relation("PayProfileUser", fields: [userId], references: [id], onDelete: Restrict)
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  updatedBy User?    @relation("PayProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([active])
  @@map("pay_profiles")
}

/// A staff member's leave request (D94, B43, B44). Approval writes the days into attendance.
model LeaveRequest {
  id            Int         @id @default(autoincrement())
  userId        Int         @map("user_id")
  startsOn      DateTime    @map("starts_on") @db.Date
  endsOn        DateTime    @map("ends_on") @db.Date
  days          Int         @db.SmallInt
  leaveType     LeaveType   @map("leave_type")
  reason        String      @db.VarChar(2000)
  status        LeaveStatus @default(pending)
  requestedById Int?        @map("requested_by")
  decidedById   Int?        @map("decided_by")
  decidedAt     DateTime?   @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?     @map("decision_note") @db.VarChar(2000)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

  user        User              @relation("LeaveRequestUser", fields: [userId], references: [id], onDelete: Restrict)
  requestedBy User?             @relation("LeaveRequestRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User?             @relation("LeaveRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  attendance  StaffAttendance[]

  @@index([userId, startsOn])
  @@index([status, startsOn])
  @@map("leave_requests")
}

/// One person's work day (D94): self check-in/out (server clock, the person's zone), a day marked
/// by staff, or an approved leave. One row per user and local work date.
model StaffAttendance {
  id             Int              @id @default(autoincrement())
  userId         Int              @map("user_id")
  workDate       DateTime         @map("work_date") @db.Date
  status         AttendanceStatus
  /// Leave only: false = unpaid (deducted from a monthly salary).
  paidLeave      Boolean          @default(true) @map("paid_leave")
  checkInAt      DateTime?        @map("check_in_at") @db.Timestamptz(6)
  checkOutAt     DateTime?        @map("check_out_at") @db.Timestamptz(6)
  /// Real elapsed minutes (UTC), so a DST night is counted right.
  workedMinutes  Int?             @map("worked_minutes")
  /// The IANA zone the work date was counted in.
  timezone       String?          @db.VarChar(64)
  source         AttendanceSource @default(self)
  leaveRequestId Int?             @map("leave_request_id")
  note           String?          @db.VarChar(1000)
  recordedById   Int?             @map("recorded_by")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  user         User          @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Restrict)
  recordedBy   User?         @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  @@unique([userId, workDate])
  @@index([workDate, status])
  @@index([userId, checkOutAt])
  @@map("staff_attendance")
}

/// One payroll month (D92): draft → reviewed → approved → paid. One run per month.
model PayrollRun {
  id           Int              @id @default(autoincrement())
  /// `YYYY-MM` in the academy zone.
  period       String           @unique @db.Char(7)
  startsOn     DateTime         @map("starts_on") @db.Date
  endsOn       DateTime         @map("ends_on") @db.Date
  status       PayrollRunStatus @default(draft)
  computedAt   DateTime?        @map("computed_at") @db.Timestamptz(6)
  createdById  Int?             @map("created_by")
  reviewedById Int?             @map("reviewed_by")
  reviewedAt   DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  approvedById Int?             @map("approved_by")
  approvedAt   DateTime?        @map("approved_at") @db.Timestamptz(6)
  paidAt       DateTime?        @map("paid_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  createdBy  User?     @relation("PayrollRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy User?     @relation("PayrollRunReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy User?     @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  payslips   Payslip[]

  @@map("payroll_runs")
}

/// One person's pay for one run, in the profile's currency (rates snapshot in `rates`).
model Payslip {
  id               Int           @id @default(autoincrement())
  runId            Int           @map("payroll_run_id")
  userId           Int           @map("user_id")
  teacherId        Int?          @map("teacher_id")
  currency         String        @db.Char(3)
  salaryType       SalaryType    @map("salary_type")
  rates            Json
  paidHours        Decimal       @default(0) @map("paid_hours") @db.Decimal(8, 2)
  paidClasses      Int           @default(0) @map("paid_classes")
  deductionDays    Int           @default(0) @map("deduction_days") @db.SmallInt
  earnings         Decimal       @default(0) @db.Decimal(12, 2)
  deductions       Decimal       @default(0) @db.Decimal(12, 2)
  /// May be negative (an error that blocks the review).
  net              Decimal       @default(0) @db.Decimal(12, 2)
  status           PayslipStatus @default(draft)
  warnings         Json          @default("[]")
  errors           Json          @default("[]")
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)
  paidOn           DateTime?     @map("paid_on") @db.Date
  paidById         Int?          @map("paid_by")
  paymentMethod    PayoutMethod? @map("payment_method")
  paymentReference String?       @map("payment_reference") @db.VarChar(120)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  run         PayrollRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  user        User                @relation("PayslipUser", fields: [userId], references: [id], onDelete: Restrict)
  teacher     Teacher?            @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  paidBy      User?               @relation("PayslipPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  lines       PayslipLine[]
  sessions    PayslipSession[]
  adjustments PayAdjustment[]
  walletTx    WalletTransaction[]

  @@unique([runId, userId])
  @@index([userId, status])
  @@map("payslips")
}

/// Fines, bonuses, advances … (D91). Nothing is deleted: cancel before approval of the month, a
/// fine reduction (`reverses_id`) after it. `payslip_id` is set when the month is approved.
model PayAdjustment {
  id           Int              @id @default(autoincrement())
  userId       Int              @map("user_id")
  type         AdjustmentType
  /// Positive; the type decides the sign.
  amount       Decimal          @db.Decimal(12, 2)
  /// `csr_conversions`: the number of conversions (amount = quantity × CSR rate).
  quantity     Int?
  currency     String           @db.Char(3)
  effectiveOn  DateTime         @map("effective_on") @db.Date
  reason       String           @db.VarChar(2000)
  status       AdjustmentStatus
  sessionId    Int?             @map("session_id")
  payslipId    Int?             @map("payslip_id")
  reversesId   Int?             @map("reverses_id")
  createdById  Int?             @map("created_by")
  decidedById  Int?             @map("decided_by")
  decidedAt    DateTime?        @map("decided_at") @db.Timestamptz(6)
  decisionNote String?          @map("decision_note") @db.VarChar(2000)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  user       User            @relation("PayAdjustmentUser", fields: [userId], references: [id], onDelete: Restrict)
  session    ClassSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  payslip    Payslip?        @relation(fields: [payslipId], references: [id], onDelete: SetNull)
  reverses   PayAdjustment?  @relation("AdjustmentReverses", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy PayAdjustment[] @relation("AdjustmentReverses")
  createdBy  User?           @relation("PayAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  decidedBy  User?           @relation("PayAdjustmentDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  lines      PayslipLine[]

  @@index([userId, effectiveOn])
  @@index([type, status])
  @@map("pay_adjustments")
}

/// A payslip line (earning, adjustment, deduction): amount positive, `sign` ±1.
model PayslipLine {
  id              Int      @id @default(autoincrement())
  payslipId       Int      @map("payslip_id")
  code            String   @db.VarChar(24)
  sign            Int      @db.SmallInt
  quantity        Decimal? @db.Decimal(10, 2)
  rate            Decimal? @db.Decimal(12, 2)
  amount          Decimal  @db.Decimal(12, 2)
  payAdjustmentId Int?     @map("pay_adjustment_id")
  position        Int      @default(0) @db.SmallInt

  payslip    Payslip        @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  adjustment PayAdjustment? @relation(fields: [payAdjustmentId], references: [id], onDelete: SetNull)

  @@index([payslipId])
  @@map("payslip_lines")
}

/// The paid classes a payslip counted (snapshot: a later class change shows up as a warning, B49).
model PayslipSession {
  id         Int       @id @default(autoincrement())
  payslipId  Int       @map("payslip_id")
  sessionId  Int       @map("session_id")
  startsAt   DateTime? @map("starts_at") @db.Timestamptz(6)
  kind       String    @db.VarChar(16)
  stage      String    @db.VarChar(20)
  payHours   Decimal   @map("pay_hours") @db.Decimal(5, 2)
  payRuleKey String?   @map("pay_rule_key") @db.VarChar(40)

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
  @@index([sessionId])
  @@map("payslip_sessions")
}

/// The teacher wallet (D93): append-only ledger (a trigger refuses UPDATE/DELETE). Approval
/// credits the net, a recorded payment debits it, a reopen reverses the credit.
model WalletTransaction {
  id          Int          @id @default(autoincrement())
  userId      Int          @map("user_id")
  currency    String       @db.Char(3)
  /// Signed.
  amount      Decimal      @db.Decimal(12, 2)
  type        WalletTxType
  payslipId   Int?         @map("payslip_id")
  reference   String?      @db.VarChar(190)
  createdById Int?         @map("created_by")
  occurredAt  DateTime     @map("occurred_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation("WalletUser", fields: [userId], references: [id], onDelete: Restrict)
  payslip   Payslip? @relation(fields: [payslipId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("WalletCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, currency])
  @@map("wallet_transactions")
}

/// Outbox for accounting (D95): written in the same transaction as the change; a later module
/// consumes it (`consumed_at`). Payroll itself makes no journal entries.
model PayrollEvent {
  id            Int       @id @default(autoincrement())
  type          String    @db.VarChar(40)
  aggregateType String    @map("aggregate_type") @db.VarChar(40)
  aggregateId   Int       @map("aggregate_id")
  payload       Json
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(6)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([consumedAt, id])
  @@map("payroll_events")
}

// ====================================================================== M7: accounting
// Chart of accounts, a double-entry journal kept per currency, vouchers and period close (docs/09
// M14, docs/07 §أ, D2). Journal entries and lines are append-only (triggers); every entry balances
// (a deferred constraint trigger); no line may be dated in a closed period (trigger). Automatic
// entries come from `billing_events` and `payroll_events` (D86, D95), one entry per event at most
// (`source_ref` unique).

enum AccountType {
  asset
  liability
  equity
  income
  expense
}

enum JournalSource {
  manual
  voucher
  billing
  payroll
  reversal
}

enum VoucherType {
  receipt
  payment
}

enum VoucherStatus {
  posted
  void
}

/// An account of the chart (old `accounts_cat` = group accounts, `accounts_head` = postable ones).
model LedgerAccount {
  id          Int         @id @default(autoincrement())
  code        String      @unique @db.VarChar(10)
  nameAr      String      @map("name_ar") @db.VarChar(120)
  nameEn      String      @map("name_en") @db.VarChar(120)
  type        AccountType
  parentId    Int?        @map("parent_id")
  /// A heading: groups accounts, never posted to.
  isGroup     Boolean     @default(false) @map("is_group")
  /// Cash, bank, gateway clearing and wallets (the cash report).
  isCash      Boolean     @default(false) @map("is_cash")
  /// Only lines in this currency may post here; null = any currency.
  currency    String?     @db.Char(3)
  /// Used by the automatic entries (`receivable`, `tuition_revenue`, …): never archived.
  systemKey   String?     @unique @map("system_key") @db.VarChar(32)
  isActive    Boolean     @default(true) @map("is_active")
  description String?     @db.VarChar(500)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

  parent       LedgerAccount?  @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     LedgerAccount[] @relation("AccountTree")
  lines        JournalLine[]
  vouchersCash Voucher[]       @relation("VoucherCashAccount")
  voucherLines VoucherLine[]

  @@index([parentId])
  @@index([type])
  @@map("ledger_accounts")
}

/// One balanced journal entry in one currency. Never changed or deleted: a reversal is a new entry.
model JournalEntry {
  id          Int           @id @default(autoincrement())
  number      String        @unique @db.VarChar(24)
  entryDate   DateTime      @map("entry_date") @db.Date
  currency    String        @db.Char(3)
  memo        String        @db.VarChar(500)
  source      JournalSource
  /// `billing_event:12`, `payroll_event:4`, `voucher:7`, `voucher_void:7`: one entry per source.
  sourceRef   String?       @unique @map("source_ref") @db.VarChar(48)
  reversesId  Int?          @unique @map("reverses_id")
  createdById Int?          @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  reverses   JournalEntry? @relation("EntryReverses", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy JournalEntry? @relation("EntryReverses")
  createdBy  User?         @relation("JournalEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines      JournalLine[]
  voucher    Voucher?      @relation("VoucherEntry")
  voidOf     Voucher?      @relation("VoucherVoidEntry")

  @@index([entryDate, id])
  @@index([currency, entryDate])
  @@index([source])
  @@index([createdById])
  @@map("journal_entries")
}

/// A debit or a credit (exactly one is > 0). `currency` and `entry_date` copy the entry's, for reports.
model JournalLine {
  id          Int      @id @default(autoincrement())
  entryId     Int      @map("entry_id")
  accountId   Int      @map("account_id")
  currency    String   @db.Char(3)
  entryDate   DateTime @map("entry_date") @db.Date
  debit       Decimal  @default(0) @db.Decimal(14, 2)
  credit      Decimal  @default(0) @db.Decimal(14, 2)
  description String?  @db.VarChar(500)
  /// `family` or `user` (sub-ledger: a family's receivable, a teacher's wallet).
  partyType   String?  @map("party_type") @db.VarChar(16)
  partyId     Int?     @map("party_id")
  position    Int      @default(0) @db.SmallInt

  entry   JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Restrict)
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId, currency, entryDate])
  @@index([currency, entryDate])
  @@index([partyType, partyId])
  @@map("journal_lines")
}

/// Receipt (قبض) or payment (صرف) voucher: posts one entry; voiding posts its reversal.
model Voucher {
  id             Int           @id @default(autoincrement())
  number         String        @unique @db.VarChar(24)
  type           VoucherType
  status         VoucherStatus @default(posted)
  voucherDate    DateTime      @map("voucher_date") @db.Date
  currency       String        @db.Char(3)
  amount         Decimal       @db.Decimal(14, 2)
  cashAccountId  Int           @map("cash_account_id")
  party          String        @db.VarChar(160)
  description    String        @db.VarChar(500)
  reference      String?       @db.VarChar(80)
  chequeNumber   String?       @map("cheque_number") @db.VarChar(40)
  journalEntryId Int           @unique @map("journal_entry_id")
  voidEntryId    Int?          @unique @map("void_entry_id")
  voidReason     String?       @map("void_reason") @db.VarChar(2000)
  voidedAt       DateTime?     @map("voided_at") @db.Timestamptz(6)
  voidedById     Int?          @map("voided_by")
  createdById    Int?          @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  cashAccount  LedgerAccount @relation("VoucherCashAccount", fields: [cashAccountId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry  @relation("VoucherEntry", fields: [journalEntryId], references: [id], onDelete: Restrict)
  voidEntry    JournalEntry? @relation("VoucherVoidEntry", fields: [voidEntryId], references: [id], onDelete: Restrict)
  voidedBy     User?         @relation("VoucherVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("VoucherCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines        VoucherLine[]

  @@index([type, status])
  @@index([voucherDate])
  @@index([cashAccountId])
  @@map("vouchers")
}

model VoucherLine {
  id          Int     @id @default(autoincrement())
  voucherId   Int     @map("voucher_id")
  accountId   Int     @map("account_id")
  amount      Decimal @db.Decimal(14, 2)
  description String? @db.VarChar(500)
  position    Int     @default(0) @db.SmallInt

  voucher Voucher       @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([voucherId])
  @@index([accountId])
  @@map("voucher_lines")
}

/// A closed month (no row = open). Reopening deletes nothing: it sets `closed = false` with a reason.
model AccountingPeriod {
  period       String    @id @db.Char(7)
  closed       Boolean   @default(true)
  closedAt     DateTime? @map("closed_at") @db.Timestamptz(6)
  closedById   Int?      @map("closed_by")
  reopenReason String?   @map("reopen_reason") @db.VarChar(2000)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  closedBy User? @relation("PeriodClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@map("accounting_periods")
}

/// Running numbers (`JE-2026`, `RV-2026`, `PV-2026` → last number).
model AccountingSequence {
  key  String @id @db.VarChar(16)
  last Int    @default(0)

  @@map("accounting_sequences")
}

/// An outbox event the ledger could not post (kept until it posts; the queue goes on meanwhile).
model LedgerOutboxFailure {
  id            Int      @id @default(autoincrement())
  source        String   @db.VarChar(16)
  eventId       Int      @map("event_id")
  eventType     String   @map("event_type") @db.VarChar(48)
  error         String   @db.VarChar(1000)
  attempts      Int      @default(1)
  lastAttemptAt DateTime @map("last_attempt_at") @db.Timestamptz(6)

  @@unique([source, eventId])
  @@map("ledger_outbox_failures")
}

// ====================================================================== M8: operations
// Tasks (given / issued, docs/03 §11), announcements, notification preferences and class reminder
// claims (docs/09 M16–M17). Complaints stay in the N4 support centre (restricted queue).

enum TaskStatus {
  pending
  awaiting
  completed
  closed
}

enum TaskPriority {
  low
  normal
  high
}

enum AnnouncementStatus {
  draft
  published
  archived
}

/// A task given by one staff member to another (or to themself). Never deleted: closed with a reason.
model Task {
  id            Int          @id @default(autoincrement())
  title         String       @db.VarChar(200)
  description   String?
  status        TaskStatus   @default(pending)
  priority      TaskPriority @default(normal)
  dueAt         DateTime?    @map("due_at") @db.Timestamptz(6)
  assigneeId    Int          @map("assignee_id")
  createdById   Int          @map("created_by")
  /// family, student, teacher, lead, session, invoice (no FK: a link shown on the task).
  subjectType   String?      @map("subject_type") @db.VarChar(16)
  subjectId     Int?         @map("subject_id")
  templateId    Int?         @map("template_id")
  submittedAt   DateTime?    @map("submitted_at") @db.Timestamptz(6)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(6)
  closedAt      DateTime?    @map("closed_at") @db.Timestamptz(6)
  closeReason   String?      @map("close_reason") @db.VarChar(2000)
  dueNotifiedAt DateTime?    @map("due_notified_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  assignee  User          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy User          @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  template  TaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  events    TaskEvent[]

  @@index([assigneeId, status])
  @@index([createdById, status])
  @@index([status, dueAt])
  @@index([subjectType, subjectId])
  @@map("tasks")
}

/// The task timeline (comments, status changes, reassignments): append-only.
model TaskEvent {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  kind      String   @db.VarChar(16)
  body      String?
  data      Json     @default("{}")
  authorId  Int?     @map("author_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Restrict)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, id])
  @@map("task_events")
}

/// A reusable task (old `task_string`).
model TaskTemplate {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(200)
  description String?
  priority    TaskPriority @default(normal)
  dueInDays   Int?         @map("due_in_days")
  isActive    Boolean      @default(true) @map("is_active")
  createdById Int?         @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@map("task_templates")
}

/// An announcement to some roles (empty audience = everyone with `announcements.view`).
model Announcement {
  id          Int                @id @default(autoincrement())
  title       String             @db.VarChar(200)
  body        String
  /// Role names.
  audience    String[]           @default([])
  pinned      Boolean            @default(false)
  status      AnnouncementStatus @default(draft)
  publishedAt DateTime?          @map("published_at") @db.Timestamptz(6)
  expiresAt   DateTime?          @map("expires_at") @db.Timestamptz(6)
  createdById Int?               @map("created_by")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)

  createdBy User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reads     AnnouncementRead[]

  @@index([status, publishedAt])
  @@map("announcements")
}

model AnnouncementRead {
  announcementId Int      @map("announcement_id")
  userId         Int      @map("user_id")
  readAt         DateTime @map("read_at") @db.Timestamptz(6)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

/// A person's channels for one notification kind (no row = the defaults).
model NotificationPreference {
  userId   Int     @map("user_id")
  kind     String  @db.VarChar(32)
  inApp    Boolean @default(true) @map("in_app")
  email    Boolean @default(false)
  push     Boolean @default(true)
  whatsapp Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
  @@map("notification_preferences")
}

/// One reminder per class and person (the claim makes the job idempotent).
model ClassReminder {
  sessionId Int      @map("session_id")
  userId    Int      @map("user_id")
  sentAt    DateTime @map("sent_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@map("class_reminders")
}

// ====================================================================== Mobile readiness
// Push device tokens (docs/17 §5): one row per token; a token moves to whoever registers it last.

enum DevicePlatform {
  ios
  android
  web
}

model DeviceToken {
  id         Int            @id @default(autoincrement())
  userId     Int            @map("user_id")
  token      String         @unique @db.VarChar(512)
  platform   DevicePlatform
  appVersion String?        @map("app_version") @db.VarChar(32)
  deviceName String?        @map("device_name") @db.VarChar(80)
  lastSeenAt DateTime       @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ====================================================================== T3 open trial offers
// A trial offered to eligible teachers (docs/33 §4.3): first to accept wins, or teachers
// volunteer and the CSR picks. Teachers see course, time, the child's age and gender only.

enum TrialOfferStatus {
  open
  claimed
  expired
  cancelled
}

enum TrialOfferPolicy {
  first_accept
  volunteer
}

enum TrialOfferResponse {
  accept
  volunteer
  decline
}

model TrialOffer {
  id               Int              @id @default(autoincrement())
  leadId           Int              @map("lead_id")
  studentId        Int              @map("student_id")
  courseId         Int              @map("course_id")
  startsAt         DateTime         @map("starts_at") @db.Timestamptz(6)
  durationMinutes  Int              @map("duration_minutes") @db.SmallInt
  /// The family's zone (the CSR's view); teachers see their own zone.
  timezone         String           @db.VarChar(64)
  policy           TrialOfferPolicy @default(first_accept)
  /// eligible | shortlist
  audience         String           @db.VarChar(16)
  status           TrialOfferStatus @default(open)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  /// Encrypted class link for the booking (optional).
  meetingUrl       String?          @map("meeting_url")
  note             String?          @db.VarChar(500)
  createdById      Int?             @map("created_by")
  claimedTeacherId Int?             @map("claimed_teacher_id")
  sessionId        Int?             @map("session_id")
  closedAt         DateTime?        @map("closed_at") @db.Timestamptz(6)
  closedById       Int?             @map("closed_by")
  /// The CSR was told the offer expired (once).
  expiryNotifiedAt DateTime?        @map("expiry_notified_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  lead           Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course         Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdBy      User?               @relation("TrialOfferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  closedBy       User?               @relation("TrialOfferClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  claimedTeacher Teacher?            @relation("TrialOfferClaimedBy", fields: [claimedTeacherId], references: [id], onDelete: SetNull)
  session        ClassSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  teachers       TrialOfferTeacher[]

  @@index([status, expiresAt])
  @@index([leadId])
  @@index([studentId, status])
  @@map("trial_offers")
}

/// A teacher the offer went to, and their answer.
model TrialOfferTeacher {
  offerId     Int                 @map("offer_id")
  teacherId   Int                 @map("teacher_id")
  /// Rank among the eligible teachers when offered.
  rank        Int?                @db.SmallInt
  response    TrialOfferResponse?
  respondedAt DateTime?           @map("responded_at") @db.Timestamptz(6)

  offer   TrialOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  teacher Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([offerId, teacherId])
  @@index([teacherId])
  @@map("trial_offer_teachers")
}

// ====================================================================== S5 WhatsApp off-ramp
/// A saved reply staff paste on WhatsApp: "please do this from the system: {link}" (docs/32 §7).
model SupportSavedReply {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(40)
  titleAr     String   @map("title_ar") @db.VarChar(120)
  titleEn     String   @map("title_en") @db.VarChar(120)
  bodyAr      String   @map("body_ar") @db.VarChar(2000)
  bodyEn      String   @map("body_en") @db.VarChar(2000)
  /// The deep link (`contactLinkSchema`), or null for none.
  link        Json?
  isActive    Boolean  @default(true) @map("is_active")
  createdById Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("support_saved_replies")
}
