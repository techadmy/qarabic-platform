// Qarabic LMS — PostgreSQL schema (docs/34 §3.3).
// Every time is timestamptz (UTC stored; the person's zone is kept in users.timezone).
// Tables and columns are snake_case; the TypeScript client uses camelCase.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  ar
  en
}

enum RoleKind {
  owner
  staff
  teacher
  parent
}

/// Family account status (docs/06 §4, docs/28 §4.1).
enum FamilyStatus {
  regular
  trial
  on_leave
  suspended
  deactivated
}

/// Students, teachers and staff.
enum ActiveStatus {
  active
  inactive
}

enum Gender {
  male
  female
}

enum StudentLanguage {
  english
  urdu
  english_urdu
  pashto
  arabic
}

enum CourseCategory {
  regular
  additional
}

/// The record a status_changes row belongs to.
enum PersonType {
  family
  student
  teacher
  staff
  enrollment
}

model User {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(255)
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  /// E.164 (`+447700900123`). A parent's phone is the family's contact number; a teacher's is theirs.
  phone             String?   @db.VarChar(16)
  locale            Locale    @default(ar)
  timezone          String    @default("Africa/Cairo") @db.VarChar(64)
  isActive          Boolean   @default(true) @map("is_active")
  roleId            Int?      @map("role_id")
  /// Staff status change (D130): why and by whom the login was (de)activated.
  statusReason      String?   @map("status_reason") @db.VarChar(500)
  statusChangedAt   DateTime? @map("status_changed_at") @db.Timestamptz(6)
  statusChangedById Int?      @map("status_changed_by")
  /// Archive ("delete", D128) of a staff member.
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedById      Int?      @map("archived_by")
  archiveReason     String?   @map("archive_reason") @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  role                Role?                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  statusChangedBy     User?                @relation("UserStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: SetNull)
  archivedBy          User?                @relation("UserArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  family              Family?              @relation("FamilyParent")
  teacher             Teacher?             @relation("TeacherUser")

  usersStatusChanged    User[]           @relation("UserStatusChangedBy")
  usersArchived         User[]           @relation("UserArchivedBy")
  managedFamilies       Family[]         @relation("FamilyManager")
  familiesStatusChanged Family[]         @relation("FamilyStatusChangedBy")
  familiesArchived      Family[]         @relation("FamilyArchivedBy")
  studentsStatusChanged Student[]        @relation("StudentStatusChangedBy")
  studentsArchived      Student[]        @relation("StudentArchivedBy")
  teachersStatusChanged Teacher[]        @relation("TeacherStatusChangedBy")
  teachersArchived      Teacher[]        @relation("TeacherArchivedBy")
  statusChanges         StatusChange[]
  auditLogs             AuditLog[]
  settingsUpdated       AppSetting[]
  enrollmentsCreated    Enrollment[]     @relation("EnrollmentCreatedBy")
  sessionEvents         SessionEvent[]
  sessionsMarked        ClassSession[]   @relation("SessionMarkedBy")
  sessionRequests       SessionRequest[] @relation("SessionRequestRequester")
  sessionDecisions      SessionRequest[] @relation("SessionRequestDecider")
  reportsSubmitted      LessonReport[]   @relation("LessonReportSubmittedBy")
  reportsUpdated        LessonReport[]   @relation("LessonReportUpdatedBy")
  testsCreated          StudentTest[]    @relation("StudentTestCreatedBy")
  testsRecorded         StudentTest[]    @relation("StudentTestRecordedBy")
  testsDecided          StudentTest[]    @relation("StudentTestDecidedBy")

  // N7 payroll back-relations.
  payProfile            PayProfile?         @relation("PayProfileUser")
  payProfilesUpdated    PayProfile[]        @relation("PayProfileUpdatedBy")
  attendance            StaffAttendance[]   @relation("AttendanceUser")
  attendanceRecorded    StaffAttendance[]   @relation("AttendanceRecordedBy")
  leaveRequests         LeaveRequest[]      @relation("LeaveRequestUser")
  leaveRequested        LeaveRequest[]      @relation("LeaveRequestRequestedBy")
  leaveDecided          LeaveRequest[]      @relation("LeaveRequestDecidedBy")
  payAdjustments        PayAdjustment[]     @relation("PayAdjustmentUser")
  payAdjustmentsMade    PayAdjustment[]     @relation("PayAdjustmentCreatedBy")
  payAdjustmentsDecided PayAdjustment[]     @relation("PayAdjustmentDecidedBy")
  payrollRunsCreated    PayrollRun[]        @relation("PayrollRunCreatedBy")
  payrollRunsReviewed   PayrollRun[]        @relation("PayrollRunReviewedBy")
  payrollRunsApproved   PayrollRun[]        @relation("PayrollRunApprovedBy")
  payslips              Payslip[]           @relation("PayslipUser")
  payslipsPaid          Payslip[]           @relation("PayslipPaidBy")
  walletTransactions    WalletTransaction[] @relation("WalletUser")
  walletTxCreated       WalletTransaction[] @relation("WalletCreatedBy")
  payRuleSetsCreated    PayRuleSet[]

  @@index([roleId])
  @@index([archivedAt])
  @@map("users")
}

model Role {
  id           Int       @id @default(autoincrement())
  /// Stable slug: system names, or `custom_<id>` for roles made in the app (docs/29).
  name         String    @unique @db.VarChar(100)
  labelAr      String    @unique @map("label_ar") @db.VarChar(255)
  labelEn      String?   @unique @map("label_en") @db.VarChar(255)
  description  String?   @db.VarChar(500)
  kind         RoleKind  @default(staff)
  isSystem     Boolean   @default(false) @map("is_system")
  customizedAt DateTime? @map("customized_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Server-side session. `id` is the sha256 (hex) of the random token in the cookie; the raw token is never stored.
model Session {
  id         String   @id @db.Char(64)
  userId     Int      @map("user_id")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use password reset token. `tokenHash` is the sha256 (hex) of the token sent by mail.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Courses (minimal for N1: the People forms pick them). Lessons, materials and pricing come later.
model Course {
  id        Int            @id @default(autoincrement())
  nameAr    String         @map("name_ar") @db.VarChar(120)
  nameEn    String         @unique @map("name_en") @db.VarChar(120)
  category  CourseCategory @default(regular)
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  regularStudents    Student[]       @relation("StudentRegularCourse")
  additionalStudents Student[]       @relation("StudentAdditionalCourse")
  teachers           TeacherCourse[]
  enrollments        Enrollment[]
  sessions           ClassSession[]
  tests              StudentTest[]

  @@map("courses")
}

/// A family = one parent login (`user_id`) and its children (docs/28 §2).
model Family {
  id                Int          @id @default(autoincrement())
  userId            Int          @unique @map("user_id")
  /// ISO 3166-1 alpha-2.
  countryCode       String?      @map("country_code") @db.Char(2)
  /// IANA zone of the family (classes are shown in it).
  timezone          String       @db.VarChar(64)
  managerId         Int?         @map("manager_id")
  startDate         DateTime?    @map("start_date") @db.Date
  trialDate         DateTime?    @map("trial_date") @db.Date
  zoomId            String?      @map("zoom_id") @db.VarChar(100)
  whatsappGroupId   String?      @map("whatsapp_group_id") @db.VarChar(100)
  comment           String?
  status            FamilyStatus @default(regular)
  statusReason      String?      @map("status_reason") @db.VarChar(500)
  statusChangedAt   DateTime?    @map("status_changed_at") @db.Timestamptz(6)
  statusChangedById Int?         @map("status_changed_by")
  archivedAt        DateTime?    @map("archived_at") @db.Timestamptz(6)
  archivedById      Int?         @map("archived_by")
  archiveReason     String?      @map("archive_reason") @db.VarChar(500)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User      @relation("FamilyParent", fields: [userId], references: [id], onDelete: Restrict)
  manager         User?     @relation("FamilyManager", fields: [managerId], references: [id], onDelete: SetNull)
  statusChangedBy User?     @relation("FamilyStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: SetNull)
  archivedBy      User?     @relation("FamilyArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  students        Student[]

  @@index([status])
  @@index([managerId])
  @@index([archivedAt])
  @@map("families")
}

/// A child of a family. No login of its own (the legacy store made a fake one).
model Student {
  id                 Int              @id @default(autoincrement())
  familyId           Int              @map("family_id")
  name               String           @db.VarChar(120)
  email              String?          @db.VarChar(191)
  gender             Gender?
  age                Int?             @db.SmallInt
  language           StudentLanguage?
  regularCourseId    Int?             @map("regular_course_id")
  additionalCourseId Int?             @map("additional_course_id")
  teacherId          Int?             @map("teacher_id")
  startDate          DateTime?        @map("start_date") @db.Date
  zoomId             String?          @map("zoom_id") @db.VarChar(100)
  remarkParent       String?          @map("remark_parent")
  remarkTeacher      String?          @map("remark_teacher")
  status             ActiveStatus     @default(active)
  statusReason       String?          @map("status_reason") @db.VarChar(500)
  statusChangedAt    DateTime?        @map("status_changed_at") @db.Timestamptz(6)
  statusChangedById  Int?             @map("status_changed_by")
  archivedAt         DateTime?        @map("archived_at") @db.Timestamptz(6)
  archivedById       Int?             @map("archived_by")
  archiveReason      String?          @map("archive_reason") @db.VarChar(500)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  family           Family           @relation(fields: [familyId], references: [id], onDelete: Restrict)
  regularCourse    Course?          @relation("StudentRegularCourse", fields: [regularCourseId], references: [id], onDelete: SetNull)
  additionalCourse Course?          @relation("StudentAdditionalCourse", fields: [additionalCourseId], references: [id], onDelete: SetNull)
  teacher          Teacher?         @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  statusChangedBy  User?            @relation("StudentStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: SetNull)
  archivedBy       User?            @relation("StudentArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  enrollments      Enrollment[]
  sessions         ClassSession[]
  sessionRequests  SessionRequest[]
  lessonReports    LessonReport[]
  hifzEntries      HifzEntry[]
  studentTests     StudentTest[]

  @@index([familyId])
  @@index([teacherId])
  @@index([status])
  @@index([archivedAt])
  @@map("students")
}

/// A teacher = one teacher login (`user_id`) + profile. Email and phone live on the user.
model Teacher {
  id                Int          @id @default(autoincrement())
  userId            Int          @unique @map("user_id")
  firstName         String       @map("first_name") @db.VarChar(60)
  lastName          String?      @map("last_name") @db.VarChar(60)
  altPhone          String?      @map("alt_phone") @db.VarChar(16)
  gender            Gender?
  nationality       String?      @db.VarChar(60)
  countryCode       String?      @map("country_code") @db.Char(2)
  timezone          String       @db.VarChar(64)
  age               Int?         @db.SmallInt
  qualification     String?
  experience        String?
  address           String?      @db.VarChar(500)
  skypeId           String?      @map("skype_id") @db.VarChar(100)
  description       String?
  status            ActiveStatus @default(active)
  statusReason      String?      @map("status_reason") @db.VarChar(500)
  statusChangedAt   DateTime?    @map("status_changed_at") @db.Timestamptz(6)
  statusChangedById Int?         @map("status_changed_by")
  archivedAt        DateTime?    @map("archived_at") @db.Timestamptz(6)
  archivedById      Int?         @map("archived_by")
  archiveReason     String?      @map("archive_reason") @db.VarChar(500)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User              @relation("TeacherUser", fields: [userId], references: [id], onDelete: Restrict)
  statusChangedBy User?             @relation("TeacherStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: SetNull)
  archivedBy      User?             @relation("TeacherArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  courses         TeacherCourse[]
  students        Student[]
  enrollments     Enrollment[]
  slots           ScheduleSlot[]
  sessions        ClassSession[]
  blocks          TeacherBlock[]
  workHours       TeacherWorkHour[]
  zoomHosts       ZoomHost[]
  lessonReports   LessonReport[]
  tests           StudentTest[]

  // N7: the hourly rate lives on the pay profile (D89); back-relations.
  payProfile PayProfile?
  payslips   Payslip[]

  @@index([status])
  @@index([archivedAt])
  @@map("teachers")
}

model TeacherCourse {
  teacherId Int @map("teacher_id")
  courseId  Int @map("course_id")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([teacherId, courseId])
  @@index([courseId])
  @@map("teacher_courses")
}

/// Status history of families, students, teachers and staff (who, when, why; docs/06 §5).
model StatusChange {
  id          Int        @id @default(autoincrement())
  subjectType PersonType @map("subject_type")
  subjectId   Int        @map("subject_id")
  fromStatus  String?    @map("from_status") @db.VarChar(32)
  toStatus    String     @map("to_status") @db.VarChar(32)
  reason      String?    @db.VarChar(500)
  changedById Int?       @map("changed_by")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([subjectType, subjectId])
  @@map("status_changes")
}

/// Who did what to which record, with the values before and after (docs/29, docs/28).
model AuditLog {
  id          Int      @id @default(autoincrement())
  actorId     Int?     @map("actor_id")
  /// e.g. `created`, `updated`, `status_changed`, `archived`, `unarchived`, `role_created`.
  action      String   @db.VarChar(64)
  subjectType String   @map("subject_type") @db.VarChar(64)
  subjectId   Int?     @map("subject_id")
  before      Json?
  after       Json?
  reason      String?  @db.VarChar(500)
  ip          String?  @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([subjectType, subjectId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Typed key/value settings with defaults in code (port of Laravel `Settings::DEFAULTS`).
model AppSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedById Int?     @map("updated_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("app_settings")
}

// ====================================================================== N2: schedule and classes
// Ported from the Laravel M2 module (docs/14, docs/04, docs/10). Times are UTC instants
// (`timestamptz`); weekly slots keep the local wall time + IANA zone (D38) so DST is exact.

enum EnrollmentStatus {
  active
  paused
  ended
}

/// What a class is (docs/14 §3.1). Set at creation, never changes. Enrollments use regular / trial.
enum SessionKind {
  regular
  trial
  rescheduled
  advance
  extra
}

/// What happened to a class (docs/14 §3.1, docs/04 status codes).
enum SessionStage {
  scheduled
  activated
  in_progress
  ended
  taken
  absent
  declined
  leave
  cancelled
  moved_out
}

enum SessionSource {
  generated
  manual
  request
  migrated
}

enum MeetingMode {
  zoom
  external
}

enum ZoomStatus {
  none
  pending
  ready
  failed
  external
  deleted
}

enum SessionRequestType {
  leave
  reschedule
  advance
  extra
}

enum SessionRequestStatus {
  pending
  approved
  auto_approved
  rejected
  cancelled
  expired
}

enum TeacherBlockKind {
  recurring
  one_off
}

/// One student studying one course with one teacher (docs/14 §2.2). At most one live (active or
/// paused) enrollment per student and course: a partial unique index in the migration.
model Enrollment {
  id                 Int              @id @default(autoincrement())
  studentId          Int              @map("student_id")
  courseId           Int              @map("course_id")
  teacherId          Int              @map("teacher_id")
  kind               SessionKind      @default(regular)
  status             EnrollmentStatus @default(active)
  /// family_suspended | family_on_leave | admin (while paused).
  pausedReason       String?          @map("paused_reason") @db.VarChar(32)
  startsOn           DateTime         @map("starts_on") @db.Date
  endsOn             DateTime?        @map("ends_on") @db.Date
  sessionMinutes     Int              @default(30) @map("session_minutes") @db.SmallInt
  /// The student's (family's) zone when the enrollment was made; new slots use it.
  timezone           String           @db.VarChar(64)
  meetingMode        MeetingMode      @default(zoom) @map("meeting_mode")
  /// Encrypted at rest (AES-256-GCM, `APP_ENCRYPTION_KEY`): `v1:` + base64.
  externalMeetingUrl String?          @map("external_meeting_url")
  notes              String?
  statusChangedAt    DateTime?        @map("status_changed_at") @db.Timestamptz(6)
  createdById        Int?             @map("created_by")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  student   Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teacher   Teacher          @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  createdBy User?            @relation("EnrollmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  slots     ScheduleSlot[]
  sessions  ClassSession[]
  requests  SessionRequest[]

  @@index([studentId, status])
  @@index([teacherId, status])
  @@index([courseId])
  @@map("enrollments")
}

/// A weekly recurring class: ISO weekday (1 = Monday) + local wall time in `timezone` (D38).
/// Never edited in place: a change closes this row (`valid_to`) and opens a new one (docs/14 §2.3).
model ScheduleSlot {
  id              Int       @id @default(autoincrement())
  enrollmentId    Int       @map("enrollment_id")
  teacherId       Int       @map("teacher_id")
  weekday         Int       @db.SmallInt
  /// `HH:MM`, local wall time in `timezone`.
  localStartTime  String    @map("local_start_time") @db.Char(5)
  durationMinutes Int       @map("duration_minutes") @db.SmallInt
  timezone        String    @db.VarChar(64)
  validFrom       DateTime  @map("valid_from") @db.Date
  validTo         DateTime? @map("valid_to") @db.Date
  createdById     Int?      @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  teacher    Teacher        @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  sessions   ClassSession[]

  @@index([teacherId, weekday])
  @@index([enrollmentId, validTo])
  @@map("schedule_slots")
}

/// Academy holidays: academy-local dates (`date` .. `ends_on`). Classes on them are cancelled.
model Holiday {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  date      DateTime  @db.Date
  endsOn    DateTime? @map("ends_on") @db.Date
  paid      Boolean   @default(true)
  appliesTo String    @default("all") @map("applies_to") @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([date])
  @@map("holidays")
}

/// Recurring ("block schedule") or one-off teacher unavailability (docs/14 §2.7).
model TeacherBlock {
  id              Int              @id @default(autoincrement())
  teacherId       Int              @map("teacher_id")
  kind            TeacherBlockKind
  /// break | other_job | leave | admin_hold | other
  reason          String           @default("other") @db.VarChar(16)
  weekday         Int?             @db.SmallInt
  localStartTime  String?          @map("local_start_time") @db.Char(5)
  durationMinutes Int?             @map("duration_minutes") @db.SmallInt
  timezone        String?          @db.VarChar(64)
  validFrom       DateTime?        @map("valid_from") @db.Date
  validTo         DateTime?        @map("valid_to") @db.Date
  startsAt        DateTime?        @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime?        @map("ends_at") @db.Timestamptz(6)
  note            String?          @db.VarChar(500)
  createdById     Int?             @map("created_by")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, kind])
  @@map("teacher_blocks")
}

/// The teacher's published weekly working hours (docs/14 §2.7). No rows = not set.
model TeacherWorkHour {
  id             Int      @id @default(autoincrement())
  teacherId      Int      @map("teacher_id")
  weekday        Int      @db.SmallInt
  localStartTime String   @map("local_start_time") @db.Char(5)
  localEndTime   String   @map("local_end_time") @db.Char(5)
  timezone       String   @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, weekday])
  @@map("teacher_work_hours")
}

/// A licensed Zoom user that may host class meetings (D43). No real Zoom calls until B7.
model ZoomHost {
  id         Int      @id @default(autoincrement())
  zoomUserId String   @unique @map("zoom_user_id") @db.VarChar(64)
  email      String   @db.VarChar(255)
  label      String?  @db.VarChar(100)
  /// A teacher's dedicated host; null = pool host.
  teacherId  Int?     @map("teacher_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher  Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  sessions ClassSession[]

  @@map("zoom_hosts")
}

/// One class occurrence (D37, docs/14 §2.4). Time = `starts_at` + `duration_minutes` (UTC);
/// state = `kind` + `stage`. The generator's key (schedule_slot_id, occurrence_date) is unique,
/// soft-deleted rows included, so a removed class is never generated again.
model ClassSession {
  id              Int           @id @default(autoincrement())
  enrollmentId    Int?          @map("enrollment_id")
  scheduleSlotId  Int?          @map("schedule_slot_id")
  /// The slot's local date (student zone) this row was generated for.
  occurrenceDate  DateTime?     @map("occurrence_date") @db.Date
  teacherId       Int           @map("teacher_id")
  studentId       Int           @map("student_id")
  courseId        Int?          @map("course_id")
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(6)
  durationMinutes Int           @map("duration_minutes") @db.SmallInt
  kind            SessionKind   @default(regular)
  stage           SessionStage  @default(scheduled)
  /// leave: student | teacher; cancelled: holiday | family_suspended | …; moved_out: rescheduled | advanced.
  stageReason     String?       @map("stage_reason") @db.VarChar(32)
  originSessionId Int?          @map("origin_session_id")
  source          SessionSource @default(manual)
  /// Shifted by hand: the generator's re-sync leaves it alone.
  isDetached      Boolean       @default(false) @map("is_detached")
  activatedAt     DateTime?     @map("activated_at") @db.Timestamptz(6)
  startedAt       DateTime?     @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime?     @map("ended_at") @db.Timestamptz(6)
  markedAt        DateTime?     @map("marked_at") @db.Timestamptz(6)
  markedById      Int?          @map("marked_by")
  needsReview     Boolean       @default(false) @map("needs_review")
  reviewReason    String?       @map("review_reason") @db.VarChar(32)
  zoomStatus      ZoomStatus    @default(none) @map("zoom_status")
  zoomMeetingId   String?       @map("zoom_meeting_id") @db.VarChar(32)
  zoomHostId      Int?          @map("zoom_host_id")
  /// Encrypted at rest (AES-256-GCM). Never sent in a class payload; only decrypted by
  /// `/zoom/start` (own teacher) and `/zoom/join` inside their windows.
  zoomJoinUrl     String?       @map("zoom_join_url")
  zoomError       String?       @map("zoom_error") @db.VarChar(255)
  actualStartedAt DateTime?     @map("actual_started_at") @db.Timestamptz(6)
  actualEndedAt   DateTime?     @map("actual_ended_at") @db.Timestamptz(6)
  teacherJoinedAt DateTime?     @map("teacher_joined_at") @db.Timestamptz(6)
  studentJoinedAt DateTime?     @map("student_joined_at") @db.Timestamptz(6)
  /// N7 pay snapshot (D41/D56), written when the stage is decided, cleared when it is undone.
  /// pay hours = rule factor × duration / 60.
  payHours        Decimal?      @map("pay_hours") @db.Decimal(5, 2)
  payRuleKey      String?       @map("pay_rule_key") @db.VarChar(40)
  payRuleSetId    Int?          @map("pay_rule_set_id")
  billable        Boolean?
  /// Optimistic concurrency: +1 on every write (409 stale_session on a mismatch).
  lockVersion     Int           @default(0) @map("lock_version")
  createdById     Int?          @map("created_by")
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Written from the app clock on every change (the board's `since` cursor reads it).
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  enrollment     Enrollment?      @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  slot           ScheduleSlot?    @relation(fields: [scheduleSlotId], references: [id], onDelete: SetNull)
  teacher        Teacher          @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course         Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  origin         ClassSession?    @relation("SessionOrigin", fields: [originSessionId], references: [id], onDelete: SetNull)
  derived        ClassSession[]   @relation("SessionOrigin")
  markedBy       User?            @relation("SessionMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  zoomHost       ZoomHost?        @relation(fields: [zoomHostId], references: [id], onDelete: SetNull)
  events         SessionEvent[]
  requests       SessionRequest[] @relation("SessionRequestSession")
  resultRequests SessionRequest[] @relation("SessionRequestResult")
  report         LessonReport?

  // N7 payroll back-relations.
  payRuleSet     PayRuleSet?     @relation(fields: [payRuleSetId], references: [id], onDelete: SetNull)
  payAdjustments PayAdjustment[]

  @@unique([scheduleSlotId, occurrenceDate], map: "class_sessions_slot_occurrence_key")
  @@index([startsAt])
  @@index([teacherId, startsAt])
  @@index([studentId, startsAt])
  @@index([enrollmentId, startsAt])
  @@index([stage, startsAt])
  @@index([updatedAt, id])
  @@index([zoomMeetingId])
  @@map("class_sessions")
}

/// Append-only per-class timeline (docs/14 §2.5): a trigger refuses UPDATE and DELETE.
model SessionEvent {
  id          Int      @id @default(autoincrement())
  sessionId   Int      @map("session_id")
  /// generated | activated | marked | reverted | cancelled | moved_out | time_changed | teacher_changed | zoom_* | note …
  type        String   @db.VarChar(32)
  fromStage   String?  @map("from_stage") @db.VarChar(20)
  toStage     String?  @map("to_stage") @db.VarChar(20)
  actorUserId Int?     @map("actor_user_id")
  actorRole   String?  @map("actor_role") @db.VarChar(100)
  payload     Json?
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(3)

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  actor   User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([sessionId, occurredAt])
  @@index([type, occurredAt])
  @@map("session_events")
}

/// Leave / reschedule / advance / extra request (docs/14 §2.6, §3.4). At most one pending
/// request of a type per class: a partial unique index in the migration.
model SessionRequest {
  id                      Int                  @id @default(autoincrement())
  type                    SessionRequestType
  sessionId               Int                  @map("session_id")
  enrollmentId            Int?                 @map("enrollment_id")
  studentId               Int                  @map("student_id")
  requestedById           Int                  @map("requested_by")
  requesterRole           String?              @map("requester_role") @db.VarChar(100)
  reason                  String
  notifiedAt              DateTime?            @map("notified_at") @db.Timestamptz(6)
  proposedStartsAt        DateTime?            @map("proposed_starts_at") @db.Timestamptz(6)
  proposedDurationMinutes Int?                 @map("proposed_duration_minutes") @db.SmallInt
  proposedTeacherId       Int?                 @map("proposed_teacher_id")
  status                  SessionRequestStatus @default(pending)
  decidedById             Int?                 @map("decided_by")
  decidedAt               DateTime?            @map("decided_at") @db.Timestamptz(6)
  decisionNote            String?              @map("decision_note")
  resultSessionId         Int?                 @map("result_session_id")
  lockVersion             Int                  @default(0) @map("lock_version")
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)

  session       ClassSession  @relation("SessionRequestSession", fields: [sessionId], references: [id], onDelete: Restrict)
  resultSession ClassSession? @relation("SessionRequestResult", fields: [resultSessionId], references: [id], onDelete: SetNull)
  enrollment    Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  requestedBy   User          @relation("SessionRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy     User?         @relation("SessionRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([studentId, status])
  @@index([sessionId])
  @@index([requestedById])
  @@map("session_requests")
}

// ====================================================================== N3: teaching
// Lesson reports, hifz progress and student tests, ported from the Laravel M3 module
// (docs/14 §2.11, docs/27, D70–D72, D113–D120).

/// sabaq = new lesson, sabaqi = recent revision, manzil = old revision.
enum HifzType {
  sabaq
  sabaqi
  manzil
}

enum HifzGrade {
  excellent
  very_good
  good
  needs_work
  not_memorised
}

/// What a student test examines (old `dept_id` 1 Qaida, 2 Nazra, 3 Hifz; docs/27 §3).
enum TestTrack {
  qaida
  nazra
  hifz
}

/// Lifecycle of a student test (docs/27 §5, D117).
enum TestStatus {
  scheduled
  taken
  refused
  cancelled
}

/// The Quran reference (Hafs numbering), seeded by the migration from `@qarabic/shared` QURAN_SURAHS.
model QuranSurah {
  number    Int    @id @db.SmallInt
  nameAr    String @map("name_ar") @db.VarChar(64)
  nameEn    String @map("name_en") @db.VarChar(64)
  ayahCount Int    @map("ayah_count") @db.SmallInt
  juzStart  Int    @map("juz_start") @db.SmallInt

  @@map("quran_surahs")
}

/// The teacher's report of one class (D45, D70; docs/14 §2.11). Writing it on an `ended` class
/// moves the class to `taken`. `teacher_notes` are internal (never sent to a parent).
model LessonReport {
  id            Int      @id @default(autoincrement())
  sessionId     Int      @unique @map("session_id")
  studentId     Int      @map("student_id")
  teacherId     Int      @map("teacher_id")
  /// What was done in class; the parent reads it.
  summary       String
  homework      String?
  tajweedNotes  String?  @map("tajweed_notes")
  /// Internal note for staff (Laravel `teacher_notes`).
  teacherNotes  String?  @map("teacher_notes")
  /// 1–5 (Laravel `behaviour`); parents see it unless `reports.parent_sees_rating` is off (B30).
  rating        Int?     @db.SmallInt
  /// End of the class + `sessions.report_due_hours` at the first submission.
  dueAt         DateTime @map("due_at") @db.Timestamptz(6)
  submittedLate Boolean  @default(false) @map("submitted_late")
  submittedById Int?     @map("submitted_by")
  submittedAt   DateTime @map("submitted_at") @db.Timestamptz(6)
  updatedById   Int?     @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Written from the app clock on every edit.
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  session     ClassSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  submittedBy User?        @relation("LessonReportSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  updatedBy   User?        @relation("LessonReportUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  hifz        HifzEntry[]

  @@index([studentId, submittedAt])
  @@index([teacherId, submittedAt])
  @@map("lesson_reports")
}

/// Structured hifz of a report by surah and ayah (docs/14 §2.11). Rewritten with the report.
model HifzEntry {
  id        Int        @id @default(autoincrement())
  reportId  Int        @map("lesson_report_id")
  sessionId Int        @map("session_id")
  studentId Int        @map("student_id")
  /// Order inside the report.
  position  Int        @default(0) @db.SmallInt
  type      HifzType
  fromSurah Int        @map("from_surah") @db.SmallInt
  fromAyah  Int        @map("from_ayah") @db.SmallInt
  toSurah   Int        @map("to_surah") @db.SmallInt
  toAyah    Int        @map("to_ayah") @db.SmallInt
  /// Ayahs covered (computed on write).
  ayahs     Int        @db.SmallInt
  /// Mushaf pages, optional (quarter pages).
  pages     Decimal?   @db.Decimal(5, 2)
  grade     HifzGrade?
  mistakes  Int?       @db.SmallInt
  notes     String?    @db.VarChar(500)
  /// The class start (copied): progress orders and buckets by when the lesson happened.
  lessonAt  DateTime   @map("lesson_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  report  LessonReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@index([studentId, type, lessonAt])
  @@map("hifz_entries")
}

/// A student test (docs/27 §4, D113): not a class; an examiner teacher at a UTC instant. Scores
/// are percentages (D115). One scheduled test per student and track: a partial unique index.
model StudentTest {
  id              Int        @id @default(autoincrement())
  studentId       Int        @map("student_id")
  /// The examiner.
  teacherId       Int        @map("teacher_id")
  courseId        Int?       @map("course_id")
  track           TestTrack
  /// Tajweed section keys (TEST_SECTIONS order).
  sections        String[]
  scheduledAt     DateTime   @map("scheduled_at") @db.Timestamptz(6)
  durationMinutes Int        @default(30) @map("duration_minutes") @db.SmallInt
  /// The student's zone when the test was scheduled.
  studentTimezone String     @map("student_timezone") @db.VarChar(64)
  notes           String?
  status          TestStatus @default(scheduled)
  statusReason    String?    @map("status_reason") @db.VarChar(500)
  tajweedScore    Int?       @map("tajweed_score") @db.SmallInt
  readingScore    Int?       @map("reading_score") @db.SmallInt
  hifzScore       Int?       @map("hifz_score") @db.SmallInt
  overallScore    Int?       @map("overall_score") @db.SmallInt
  /// Mistake codes 1–26, sorted.
  mistakes        Int[]      @default([])
  /// Shown to the parent.
  remarks         String?
  /// Staff and teachers only.
  internalNotes   String?    @map("internal_notes")
  /// 0–100, staff only (B67).
  teacherRating   Int?       @map("teacher_rating") @db.SmallInt
  recordedAt      DateTime?  @map("recorded_at") @db.Timestamptz(6)
  recordedById    Int?       @map("recorded_by")
  createdById     Int?       @map("created_by")
  decidedById     Int?       @map("decided_by")
  decidedAt       DateTime?  @map("decided_at") @db.Timestamptz(6)
  /// The old `test_results.test_id` (import, later).
  legacyId        Int?       @unique @map("legacy_id")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)

  student    Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher    Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  course     Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  recordedBy User?   @relation("StudentTestRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdBy  User?   @relation("StudentTestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  decidedBy  User?   @relation("StudentTestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([teacherId, scheduledAt])
  @@index([studentId, scheduledAt])
  @@map("student_tests")
}

// ====================================================================== N7: payroll
// Ported from the Laravel M6 module (docs/21, D41, D89–D95): pay rules, pay profiles, staff
// attendance and leave, pay adjustments (fines …), monthly payroll runs, payslips, the wallet and
// the payroll outbox. Money = numeric(12,2) + ISO currency; services compute in integer minor
// units. Payroll never moves money (D140): a payment is recorded, not made.

/// Old `profile.Salary` 1–4 (docs/21 §2).
enum SalaryType {
  monthly
  per_class
  hourly
  slot
}

enum AttendanceStatus {
  present
  absent
  leave
  holiday
}

enum AttendanceSource {
  self
  staff
  leave
}

enum LeaveType {
  paid
  unpaid
  sick
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

/// Old `teacher_fine.type` 1–8 plus CSR conversions.
enum AdjustmentType {
  fine
  bonus
  advance
  arrears
  fine_reduction
  gift
  other_addition
  other_deduction
  csr_conversions
}

enum AdjustmentStatus {
  proposed
  approved
  rejected
  cancelled
}

enum PayrollRunStatus {
  draft
  reviewed
  approved
  paid
}

enum PayslipStatus {
  draft
  approved
  paid
}

enum PaymentMethod {
  vodafone_cash
  bank_transfer
  cash
  other
}

enum WalletTxType {
  salary_credit
  salary_payment
  reversal
}

/// Immutable pay rule version (D41): a change inserts a new set (a trigger refuses UPDATE/DELETE).
/// `rules` = { key: { factor, billable, paidHolidayOnly? } }; the set in force at a class start applies.
model PayRuleSet {
  id            Int      @id @default(autoincrement())
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(6)
  rules         Json
  note          String?  @db.VarChar(255)
  createdById   Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sessions  ClassSession[]

  @@index([effectiveFrom])
  @@map("pay_rule_sets")
}

/// How a staff member or teacher is paid (D89; old `profile` salary fields). One per user.
model PayProfile {
  id            Int        @id @default(autoincrement())
  userId        Int        @unique @map("user_id")
  teacherId     Int?       @unique @map("teacher_id")
  salaryType    SalaryType @default(hourly) @map("salary_type")
  /// Null = the payroll default currency (EGP).
  currency      String?    @db.Char(3)
  monthlySalary Decimal    @default(0) @map("monthly_salary") @db.Decimal(12, 2)
  classRate     Decimal    @default(0) @map("class_rate") @db.Decimal(12, 2)
  hourlyRate    Decimal    @default(0) @map("hourly_rate") @db.Decimal(12, 2)
  csrRate       Decimal    @default(0) @map("csr_rate") @db.Decimal(12, 2)
  allowance     Decimal    @default(0) @db.Decimal(12, 2)
  tax           Decimal    @default(0) @db.Decimal(12, 2)
  /// [{ minSlots, amount }] sorted by minSlots (slot type only).
  slotTiers     Json       @default("[]") @map("slot_tiers")
  active        Boolean    @default(true)
  notes         String?    @db.VarChar(500)
  updatedById   Int?       @map("updated_by")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User     @relation("PayProfileUser", fields: [userId], references: [id], onDelete: Restrict)
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  updatedBy User?    @relation("PayProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([active])
  @@map("pay_profiles")
}

/// A staff member's leave request (D94, B43, B44). Approval writes the days into attendance.
model LeaveRequest {
  id            Int         @id @default(autoincrement())
  userId        Int         @map("user_id")
  startsOn      DateTime    @map("starts_on") @db.Date
  endsOn        DateTime    @map("ends_on") @db.Date
  days          Int         @db.SmallInt
  leaveType     LeaveType   @map("leave_type")
  reason        String      @db.VarChar(2000)
  status        LeaveStatus @default(pending)
  requestedById Int?        @map("requested_by")
  decidedById   Int?        @map("decided_by")
  decidedAt     DateTime?   @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?     @map("decision_note") @db.VarChar(2000)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

  user        User              @relation("LeaveRequestUser", fields: [userId], references: [id], onDelete: Restrict)
  requestedBy User?             @relation("LeaveRequestRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User?             @relation("LeaveRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  attendance  StaffAttendance[]

  @@index([userId, startsOn])
  @@index([status, startsOn])
  @@map("leave_requests")
}

/// One person's work day (D94): self check-in/out (server clock, the person's zone), a day marked
/// by staff, or an approved leave. One row per user and local work date.
model StaffAttendance {
  id             Int              @id @default(autoincrement())
  userId         Int              @map("user_id")
  workDate       DateTime         @map("work_date") @db.Date
  status         AttendanceStatus
  /// Leave only: false = unpaid (deducted from a monthly salary).
  paidLeave      Boolean          @default(true) @map("paid_leave")
  checkInAt      DateTime?        @map("check_in_at") @db.Timestamptz(6)
  checkOutAt     DateTime?        @map("check_out_at") @db.Timestamptz(6)
  /// Real elapsed minutes (UTC), so a DST night is counted right.
  workedMinutes  Int?             @map("worked_minutes")
  /// The IANA zone the work date was counted in.
  timezone       String?          @db.VarChar(64)
  source         AttendanceSource @default(self)
  leaveRequestId Int?             @map("leave_request_id")
  note           String?          @db.VarChar(1000)
  recordedById   Int?             @map("recorded_by")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  user         User          @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Restrict)
  recordedBy   User?         @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  @@unique([userId, workDate])
  @@index([workDate, status])
  @@index([userId, checkOutAt])
  @@map("staff_attendance")
}

/// One payroll month (D92): draft → reviewed → approved → paid. One run per month.
model PayrollRun {
  id           Int              @id @default(autoincrement())
  /// `YYYY-MM` in the academy zone.
  period       String           @unique @db.Char(7)
  startsOn     DateTime         @map("starts_on") @db.Date
  endsOn       DateTime         @map("ends_on") @db.Date
  status       PayrollRunStatus @default(draft)
  computedAt   DateTime?        @map("computed_at") @db.Timestamptz(6)
  createdById  Int?             @map("created_by")
  reviewedById Int?             @map("reviewed_by")
  reviewedAt   DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  approvedById Int?             @map("approved_by")
  approvedAt   DateTime?        @map("approved_at") @db.Timestamptz(6)
  paidAt       DateTime?        @map("paid_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  createdBy  User?     @relation("PayrollRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy User?     @relation("PayrollRunReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy User?     @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  payslips   Payslip[]

  @@map("payroll_runs")
}

/// One person's pay for one run, in the profile's currency (rates snapshot in `rates`).
model Payslip {
  id               Int            @id @default(autoincrement())
  runId            Int            @map("payroll_run_id")
  userId           Int            @map("user_id")
  teacherId        Int?           @map("teacher_id")
  currency         String         @db.Char(3)
  salaryType       SalaryType     @map("salary_type")
  rates            Json
  paidHours        Decimal        @default(0) @map("paid_hours") @db.Decimal(8, 2)
  paidClasses      Int            @default(0) @map("paid_classes")
  deductionDays    Int            @default(0) @map("deduction_days") @db.SmallInt
  earnings         Decimal        @default(0) @db.Decimal(12, 2)
  deductions       Decimal        @default(0) @db.Decimal(12, 2)
  /// May be negative (an error that blocks the review).
  net              Decimal        @default(0) @db.Decimal(12, 2)
  status           PayslipStatus  @default(draft)
  warnings         Json           @default("[]")
  errors           Json           @default("[]")
  paidAt           DateTime?      @map("paid_at") @db.Timestamptz(6)
  paidOn           DateTime?      @map("paid_on") @db.Date
  paidById         Int?           @map("paid_by")
  paymentMethod    PaymentMethod? @map("payment_method")
  paymentReference String?        @map("payment_reference") @db.VarChar(120)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)

  run         PayrollRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  user        User                @relation("PayslipUser", fields: [userId], references: [id], onDelete: Restrict)
  teacher     Teacher?            @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  paidBy      User?               @relation("PayslipPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  lines       PayslipLine[]
  sessions    PayslipSession[]
  adjustments PayAdjustment[]
  walletTx    WalletTransaction[]

  @@unique([runId, userId])
  @@index([userId, status])
  @@map("payslips")
}

/// Fines, bonuses, advances … (D91). Nothing is deleted: cancel before approval of the month, a
/// fine reduction (`reverses_id`) after it. `payslip_id` is set when the month is approved.
model PayAdjustment {
  id           Int              @id @default(autoincrement())
  userId       Int              @map("user_id")
  type         AdjustmentType
  /// Positive; the type decides the sign.
  amount       Decimal          @db.Decimal(12, 2)
  /// `csr_conversions`: the number of conversions (amount = quantity × CSR rate).
  quantity     Int?
  currency     String           @db.Char(3)
  effectiveOn  DateTime         @map("effective_on") @db.Date
  reason       String           @db.VarChar(2000)
  status       AdjustmentStatus
  sessionId    Int?             @map("session_id")
  payslipId    Int?             @map("payslip_id")
  reversesId   Int?             @map("reverses_id")
  createdById  Int?             @map("created_by")
  decidedById  Int?             @map("decided_by")
  decidedAt    DateTime?        @map("decided_at") @db.Timestamptz(6)
  decisionNote String?          @map("decision_note") @db.VarChar(2000)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  user       User            @relation("PayAdjustmentUser", fields: [userId], references: [id], onDelete: Restrict)
  session    ClassSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  payslip    Payslip?        @relation(fields: [payslipId], references: [id], onDelete: SetNull)
  reverses   PayAdjustment?  @relation("AdjustmentReverses", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy PayAdjustment[] @relation("AdjustmentReverses")
  createdBy  User?           @relation("PayAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  decidedBy  User?           @relation("PayAdjustmentDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  lines      PayslipLine[]

  @@index([userId, effectiveOn])
  @@index([type, status])
  @@map("pay_adjustments")
}

/// A payslip line (earning, adjustment, deduction): amount positive, `sign` ±1.
model PayslipLine {
  id              Int      @id @default(autoincrement())
  payslipId       Int      @map("payslip_id")
  code            String   @db.VarChar(24)
  sign            Int      @db.SmallInt
  quantity        Decimal? @db.Decimal(10, 2)
  rate            Decimal? @db.Decimal(12, 2)
  amount          Decimal  @db.Decimal(12, 2)
  payAdjustmentId Int?     @map("pay_adjustment_id")
  position        Int      @default(0) @db.SmallInt

  payslip    Payslip        @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  adjustment PayAdjustment? @relation(fields: [payAdjustmentId], references: [id], onDelete: SetNull)

  @@index([payslipId])
  @@map("payslip_lines")
}

/// The paid classes a payslip counted (snapshot: a later class change shows up as a warning, B49).
model PayslipSession {
  id         Int       @id @default(autoincrement())
  payslipId  Int       @map("payslip_id")
  sessionId  Int       @map("session_id")
  startsAt   DateTime? @map("starts_at") @db.Timestamptz(6)
  kind       String    @db.VarChar(16)
  stage      String    @db.VarChar(20)
  payHours   Decimal   @map("pay_hours") @db.Decimal(5, 2)
  payRuleKey String?   @map("pay_rule_key") @db.VarChar(40)

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
  @@index([sessionId])
  @@map("payslip_sessions")
}

/// The teacher wallet (D93): append-only ledger (a trigger refuses UPDATE/DELETE). Approval
/// credits the net, a recorded payment debits it, a reopen reverses the credit.
model WalletTransaction {
  id          Int          @id @default(autoincrement())
  userId      Int          @map("user_id")
  currency    String       @db.Char(3)
  /// Signed.
  amount      Decimal      @db.Decimal(12, 2)
  type        WalletTxType
  payslipId   Int?         @map("payslip_id")
  reference   String?      @db.VarChar(190)
  createdById Int?         @map("created_by")
  occurredAt  DateTime     @map("occurred_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation("WalletUser", fields: [userId], references: [id], onDelete: Restrict)
  payslip   Payslip? @relation(fields: [payslipId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("WalletCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, currency])
  @@map("wallet_transactions")
}

/// Outbox for accounting (D95): written in the same transaction as the change; a later module
/// consumes it (`consumed_at`). Payroll itself makes no journal entries.
model PayrollEvent {
  id            Int       @id @default(autoincrement())
  type          String    @db.VarChar(40)
  aggregateType String    @map("aggregate_type") @db.VarChar(40)
  aggregateId   Int       @map("aggregate_id")
  payload       Json
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(6)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([consumedAt, id])
  @@map("payroll_events")
}
