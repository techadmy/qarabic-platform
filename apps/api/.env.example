# Copy to .env (gitignored). Never put real production values in this file.
NODE_ENV=development
PORT=3001
# Local Postgres 17 (see README): port 5433.
DATABASE_URL=postgresql://postgres@localhost:5433/qarabic_dev
# Used by `pnpm test:e2e` (tables are truncated between tests: never point it at real data).
TEST_DATABASE_URL=postgresql://postgres@localhost:5433/qarabic_test
# The web app origin (CORS with credentials) and the base for links in mails.
WEB_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
# At least 32 random characters (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-32-or-more-random-characters
LOG_LEVEL=info
# N5 CRM public intake. Website WPForms webhook: the secret shared with the WordPress snippet
# (`openssl rand -hex 32`); empty = webhook off (503). Form ids accepted; course label → id map.
WEB_LEADS_WEBHOOK_SECRET=
WEB_LEADS_WPFORMS_FORM_IDS=4823
WEB_LEADS_COURSE_MAP={}
# Public trial form: honeypot field, captcha (none | turnstile + TURNSTILE_SECRET_KEY), rate limits.
FORMS_HONEYPOT_FIELD=website
FORMS_CAPTCHA_DRIVER=none
TURNSTILE_SECRET_KEY=
FORMS_CLASS_REQUEST_PER_MINUTE=5
FORMS_WEB_LEADS_PER_MINUTE=30
# Dev-only seed admin (ignored in production). Placeholders only.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=change-me
# Made-up demo families, students, teachers and staff on `db:seed` (dev only). 0 = skip.
SEED_DEMO=1
# Zoom meetings driver: none (no Zoom account yet: classes use the enrollment's fixed link) | fake.
ZOOM_DRIVER=none
# Run the class generator and the other class jobs (cron) in this process. One API process only.
SCHEDULER_ENABLED=true
# AES-256-GCM key for meeting links at rest: 32 random bytes in base64 (`openssl rand -base64 32`).
# This all-zero placeholder works locally only; production refuses it.
APP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Private files (ticket screenshots): local disk folder (gitignored). S3 / Spaces later.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/private
# WhatsApp intake of support tickets: off until the Meta app is set up (B50). Never commit real values.
FEEDBACK_WHATSAPP_ENABLED=false
FEEDBACK_WHATSAPP_ALLOW_UNKNOWN=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# N6 billing (D88, D140): Stripe TEST keys and PayPal SANDBOX only. Empty = that provider is off.
# Outside production the API refuses to start with a live key, PayPal live mode or BILLING_ALLOW_LIVE.
BILLING_STRIPE_SECRET=
BILLING_STRIPE_WEBHOOK_SECRET=
BILLING_PAYPAL_CLIENT_ID=
BILLING_PAYPAL_SECRET=
BILLING_PAYPAL_WEBHOOK_ID=
BILLING_PAYPAL_MODE=sandbox
# Real money: production only, after Ahmed's go-live decision (B40). Keep false.
BILLING_ALLOW_LIVE=false
BILLING_INVOICE_PREFIX=INV
