# Copy to .env (gitignored). Never put real production values in this file.
NODE_ENV=development
PORT=3001
# Local Postgres 17 (see README): port 5433.
DATABASE_URL=postgresql://postgres@localhost:5433/qarabic_dev
# Used by `pnpm test:e2e` (tables are truncated between tests: never point it at real data).
TEST_DATABASE_URL=postgresql://postgres@localhost:5433/qarabic_test
# The web app origin (CORS with credentials) and the base for links in mails.
WEB_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
# At least 32 random characters (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-32-or-more-random-characters
LOG_LEVEL=info
# Dev-only seed admin (ignored in production). Placeholders only.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=change-me
# Made-up demo families, students, teachers and staff on `db:seed` (dev only). 0 = skip.
SEED_DEMO=1
