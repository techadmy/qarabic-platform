{
  "extends": "@qarabic/config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@qarabic/ui/*": ["../../packages/ui/src/*"]
    },
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".next-*", "playwright-report", "test-results"]
}
