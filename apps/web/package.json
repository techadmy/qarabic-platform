{
  "name": "@qarabic/web",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:mocks": "NEXT_PUBLIC_ENABLE_MOCKS=true next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "msw:init": "msw init public --save",
    "test:e2e:real": "E2E_REAL_API=1 playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@qarabic/shared": "workspace:*",
    "@qarabic/ui": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-intl": "^4.15.0",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@qarabic/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^27.0.0",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
