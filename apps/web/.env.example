# Base URL of the NestJS API (no trailing slash). Requests go to `${NEXT_PUBLIC_API_URL}/api/v1/...`.
# Empty = same origin (e.g. behind one nginx host).
NEXT_PUBLIC_API_URL=http://localhost:4000

# true = answer the API contract with MSW mocks in the browser (no API needed).
# Mock users: admin@qarabic.test, teacher@qarabic.test, parent@qarabic.test; password in mocks/data.ts.
NEXT_PUBLIC_ENABLE_MOCKS=false
