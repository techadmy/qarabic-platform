# /etc/qarabic/api.env — the production API's environment (docs/36 §3.4).
# Mode 640, owner root:qarabic. NEVER commit real values. deploy/prepare-server.sh creates the
# file from this template and fills only DATABASE_URL, SESSION_SECRET and APP_ENCRYPTION_KEY with
# values generated on the server (never printed). Everything marked <set on server> is copied by
# hand on the server. Read by Node itself (`node --env-file`): plain KEY=value lines, no quotes.

NODE_ENV=production
PORT=4100
LOG_LEVEL=info
TZ=UTC
# Postgres 17 on 127.0.0.1; role `qarabic`, database `qarabic`. Generated by prepare-server.sh.
DATABASE_URL=
# Same origin: the web app is served from https://api.qarabic.com/app/ (docs/36 §1).
WEB_ORIGIN=https://api.qarabic.com
# Links in mails and the checkout return URL.
APP_URL=https://api.qarabic.com/app
# Express `trust proxy`: nginx on the same host.
TRUST_PROXY=loopback
# Generated (openssl rand -hex 32).
SESSION_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32). Generated once. BACK IT UP OFFLINE:
# meeting links are encrypted with it; losing it loses them.
APP_ENCRYPTION_KEY=

# Jobs (class generator, reminders, payroll): OFF until the night's step 8 (switch.sh jobs-on).
# Exactly one process may have it on: qarabic-api. The rehearsal API never.
SCHEDULER_ENABLED=false
ZOOM_DRIVER=none

# Private files (ticket screenshots). Copy Laravel storage/app/<path> here at cut-over (docs/37 §5).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/srv/qarabic/storage/private

# Website WPForms webhook: THE SAME secret Laravel uses (copied on the server, never printed).
WEB_LEADS_WEBHOOK_SECRET=<set on server>
WEB_LEADS_WPFORMS_FORM_IDS=4823
WEB_LEADS_COURSE_MAP={}
FORMS_HONEYPOT_FIELD=website
FORMS_CAPTCHA_DRIVER=none
TURNSTILE_SECRET_KEY=
FORMS_CLASS_REQUEST_PER_MINUTE=5
FORMS_WEB_LEADS_PER_MINUTE=30

# WhatsApp ticket intake: off (B50).
FEEDBACK_WHATSAPP_ENABLED=false
FEEDBACK_WHATSAPP_ALLOW_UNKNOWN=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Billing: TEST / SANDBOX keys only, or empty (= provider off). No real money (D140, B28).
BILLING_STRIPE_SECRET=
BILLING_STRIPE_WEBHOOK_SECRET=
BILLING_PAYPAL_CLIENT_ID=
BILLING_PAYPAL_SECRET=
BILLING_PAYPAL_WEBHOOK_ID=
BILLING_PAYPAL_MODE=sandbox
BILLING_ALLOW_LIVE=false
BILLING_INVOICE_PREFIX=INV

# Mail: no SMTP yet (B31); the API logs the kind of each mail only, sends nothing.
# Parent / payslip emails stay off in the app settings: billing.notify_parents=false,
# payroll.payslip_emails=false (defaults; check them after the import, docs/36 §6.7).

# N8 import only (legacy:import / legacy:verify). Remove the two secrets after the night.
# A SELECT-only MySQL user (B93). Laravel's APP_KEY decrypts meeting links (never printed).
LEGACY_DATABASE_URL=<set on server>
LEGACY_APP_KEY=<set on server>
LEGACY_APP_TIMEZONE=UTC
