# /etc/qarabic/api-rehearsal.env — the server rehearsal API (docs/36 §5), port 4200, database
# qarabic_rehearsal, opened by Ahmed through an SSH tunnel at http://localhost:4001/app/.
# Only overrides: the rehearsal API reads api.env first, then this file (Node `--env-file` twice,
# the last wins). prepare-server.sh fills DATABASE_URL and its own SESSION_SECRET.
# Same rules: mode 640 root:qarabic, never committed, never printed.

PORT=4200
DATABASE_URL=
WEB_ORIGIN=http://localhost:4001
APP_URL=http://localhost:4001/app
# Never on in the rehearsal: no class generation, no reminders, no mails.
SCHEDULER_ENABLED=false
SESSION_SECRET=
STORAGE_LOCAL_DIR=/srv/qarabic/storage/rehearsal
